generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvoiceEmailDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  SPAM_COMPLAINT
}

enum AuthAuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  SESSION_REVOKED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  fullName     String?
  timeZone     String?
  passwordHash String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  memberships  OrganizationMembership[]
  sessions      Session[]
  passwordResetTokens PasswordResetToken[]
  authAuditEvents AuthAuditEvent[]
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Session {
  id             String    @id
  data           Json
  userId         String?
  organizationId String?   @db.Uuid
  expiresAt      DateTime
  lastSeenAt     DateTime
  revokedAt      DateTime?
  userAgent      String?
  ip             String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([lastSeenAt])
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  /// Display name kept in sync with legalName for now. May become a separate trading name in the future.
  name        String
  legalName   String?
  taxId       String?
  addressLine1 String?
  city        String?
  country     String?
  countryCode String?
  legalForm   String   @default("other")
  currency    String   @default("EUR")
  locale      String   @default("en-GB")
  paymentInstructions String?
  billingEmail String?
  withholdingEnabled Boolean @default(false)
  defaultWithholdingType String?
  defaultWithholdingRate Decimal? @db.Decimal(5, 2)
  sessionIdleTimeoutMinutes Int @default(30)
  sessionAbsoluteLifetimeDays Int @default(14)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships            OrganizationMembership[]
  sessions               Session[]
  customers              Customer[]
  invoices               Invoice[]
  invoiceNumberSequences InvoiceNumberSequence[]
  invoicePublicAccessTokens InvoicePublicAccessToken[]
  invoiceEmailDeliveries    InvoiceEmailDelivery[]
  catalogItems              CatalogItem[]
  authAuditEvents           AuthAuditEvent[]

  @@index([name])
}

model AuthAuditEvent {
  id             String             @id @default(uuid()) @db.Uuid
  type           AuthAuditEventType
  userId         String?
  organizationId String?            @db.Uuid
  sessionId      String?
  email          String?
  ip             String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime           @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([userId])
  @@index([organizationId])
  @@index([sessionId])
  @@index([email])
  @@index([createdAt])
}

model CatalogItem {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  description    String?
  unitPriceCents Int
  currency       String
  taxRateBps     Int          @default(0)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([name])
  @@index([archivedAt])
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String
  organizationId String           @db.Uuid
  role           OrganizationRole @default(MEMBER)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
}

model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name         String
  email        String?
  taxId        String?
  addressLine1 String?
  city         String?
  country      String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@index([organizationId])
  @@index([name])
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  number         String
  status         InvoiceStatus @default(DRAFT)
  paymentStatus  PaymentStatus @default(UNPAID)
  customerId     String        @db.Uuid
  issueDate      DateTime
  dueDate        DateTime
  subtotalCents  Int
  discountCents  Int           @default(0)
  taxCents       Int           @default(0)
  withholdingType String?
  withholdingRate Decimal?     @db.Decimal(5, 2)
  withholdingAmountCents Int?
  totalCents     Int
  currency       String
  paymentInstructions String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          InvoiceLine[]
  payments       Payment[]
  snapshot       InvoiceSnapshot?
  publicAccessTokens InvoicePublicAccessToken[]
  emailDeliveries    InvoiceEmailDelivery[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([dueDate])
}

model InvoiceNumberSequence {
  organizationId String       @db.Uuid
  year           Int
  nextValue      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, year])
  @@index([organizationId])
}

model InvoiceSnapshot {
  invoiceId            String   @id @db.Uuid
  customerName         String
  customerEmail        String?
  customerTaxId        String?
  customerAddressLine1 String?
  customerCity         String?
  customerCountry      String?
  sellerName           String
  sellerLegalName      String?
  sellerTaxId          String?
  sellerAddressLine1   String?
  sellerCity           String?
  sellerCountry        String?
  paymentInstructions  String?
  subtotalCents        Int
  discountCents        Int
  taxCents             Int
  withholdingType      String?
  withholdingRate      Decimal? @db.Decimal(5, 2)
  withholdingAmountCents Int?
  totalCents           Int
  createdAt            DateTime @default(now())
  invoice              Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceLine {
  id                   String   @id @default(uuid()) @db.Uuid
  invoiceId            String   @db.Uuid
  description          String
  quantity             Decimal  @db.Decimal(12, 2)
  unitPriceCents       Int
  discountCents        Int      @default(0)
  invoiceDiscountCents Int      @default(0)
  taxRateBps           Int      @default(0)
  taxCents             Int      @default(0)
  totalCents           Int
  createdAt            DateTime @default(now())
  invoice              Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  amountCents Int
  paidAt      DateTime
  reference   String?
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoicePublicAccessToken {
  id             String    @id @default(uuid()) @db.Uuid
  invoiceId      String    @db.Uuid
  organizationId String    @db.Uuid
  tokenHash      String    @unique
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   InvoiceEmailDelivery[]

  @@index([invoiceId])
  @@index([organizationId])
  @@index([revokedAt])
}

model InvoiceEmailDelivery {
  id                  String                     @id @default(uuid()) @db.Uuid
  invoiceId           String                     @db.Uuid
  organizationId      String                     @db.Uuid
  publicAccessTokenId String?                    @db.Uuid
  toEmail             String
  subject             String
  provider            String                     @default("postmark")
  providerMessageId   String?
  status              InvoiceEmailDeliveryStatus @default(PENDING)
  errorMessage        String?
  metadata            Json?
  sentAt              DateTime?
  deliveredAt         DateTime?
  failedAt            DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  invoice           Invoice                   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publicAccessToken InvoicePublicAccessToken? @relation(fields: [publicAccessTokenId], references: [id], onDelete: SetNull)
  events            InvoiceEmailEvent[]

  @@index([invoiceId])
  @@index([organizationId])
  @@index([providerMessageId])
  @@index([status])
}

model InvoiceEmailEvent {
  id                String   @id @default(uuid()) @db.Uuid
  deliveryId        String?  @db.Uuid
  provider          String   @default("postmark")
  providerMessageId String?
  recordType        String
  payload           Json
  createdAt         DateTime @default(now())

  delivery InvoiceEmailDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@index([deliveryId])
  @@index([providerMessageId])
  @@index([recordType])
}
