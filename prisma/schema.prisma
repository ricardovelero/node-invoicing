generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum InvoiceFiscalRecordType {
  ALTA
  ANULACION
}

enum VerifactuRecordStatus {
  GENERATED
  SUBMISSION_PENDING
  SUBMITTED
  ACCEPTED
  ACCEPTED_WITH_ERRORS
  REJECTED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvoiceEmailDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  SPAM_COMPLAINT
}

enum AuthAuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  SESSION_REVOKED
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  fullName     String?
  timeZone     String?
  passwordHash String

  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  memberships          OrganizationMembership[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  authAuditEvents      AuthAuditEvent[]
  invoiceFiscalRecords InvoiceFiscalRecord[]
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Session {
  id             String    @id
  data           Json
  userId         String?
  organizationId String?   @db.Uuid
  expiresAt      DateTime
  lastSeenAt     DateTime
  revokedAt      DateTime?
  userAgent      String?
  ip             String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([lastSeenAt])
}

model Organization {
  id                          String   @id @default(uuid()) @db.Uuid
  /// Display name kept in sync with legalName for now. May become a separate trading name in the future.
  name                        String
  legalName                   String?
  taxId                       String?
  addressLine1                String?
  city                        String?
  country                     String?
  countryCode                 String?
  legalForm                   String   @default("other")
  currency                    String   @default("EUR")
  locale                      String   @default("en-GB")
  paymentInstructions         String?
  billingEmail                String?
  withholdingEnabled          Boolean  @default(false)
  defaultWithholdingType      String?
  defaultWithholdingRate      Decimal? @db.Decimal(5, 2)
  sessionIdleTimeoutMinutes   Int      @default(30)
  sessionAbsoluteLifetimeDays Int      @default(14)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships                 OrganizationMembership[]
  sessions                    Session[]
  customers                   Customer[]
  invoices                    Invoice[]
  invoiceNumberSequences      InvoiceNumberSequence[]
  invoiceFiscalRecordSequence InvoiceFiscalRecordSequence?
  invoiceFiscalRecords        InvoiceFiscalRecord[]
  verifactuRecords            VerifactuRecord[]
  invoicePublicAccessTokens   InvoicePublicAccessToken[]
  invoiceEmailDeliveries      InvoiceEmailDelivery[]
  catalogItems                CatalogItem[]
  authAuditEvents             AuthAuditEvent[]

  @@index([name])
}

model AuthAuditEvent {
  id             String             @id @default(uuid()) @db.Uuid
  type           AuthAuditEventType
  userId         String?
  organizationId String?            @db.Uuid
  sessionId      String?
  email          String?
  ip             String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime           @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([userId])
  @@index([organizationId])
  @@index([sessionId])
  @@index([email])
  @@index([createdAt])
}

model CatalogItem {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  description    String?
  unitPriceCents Int
  currency       String
  taxRateBps     Int          @default(0)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([name])
  @@index([archivedAt])
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String
  organizationId String           @db.Uuid
  role           OrganizationRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  email          String?
  taxId          String?
  addressLine1   String?
  city           String?
  country        String?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]

  @@index([organizationId])
  @@index([name])
}

model Invoice {
  id                     String                     @id @default(uuid()) @db.Uuid
  organizationId         String                     @db.Uuid
  number                 String
  status                 InvoiceStatus              @default(DRAFT)
  paymentStatus          PaymentStatus              @default(UNPAID)
  customerId             String                     @db.Uuid
  issueDate              DateTime
  dueDate                DateTime
  subtotalCents          Int
  discountCents          Int                        @default(0)
  taxCents               Int                        @default(0)
  withholdingType        String?
  withholdingRate        Decimal?                   @db.Decimal(5, 2)
  withholdingAmountCents Int?
  totalCents             Int
  currency               String
  paymentInstructions    String?
  notes                  String?
  replacesInvoiceId      String?                    @unique @db.Uuid
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  customer               Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  organization           Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  replacesInvoice        Invoice?                   @relation("InvoiceReplacement", fields: [replacesInvoiceId], references: [id], onDelete: Restrict)
  replacementInvoice     Invoice?                   @relation("InvoiceReplacement")
  lines                  InvoiceLine[]
  payments               Payment[]
  snapshot               InvoiceSnapshot?
  fiscalRecords          InvoiceFiscalRecord[]
  verifactuRecords       VerifactuRecord[]
  publicAccessTokens     InvoicePublicAccessToken[]
  emailDeliveries        InvoiceEmailDelivery[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([dueDate])
}

model InvoiceNumberSequence {
  organizationId String       @db.Uuid
  year           Int
  nextValue      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, year])
  @@index([organizationId])
}

model InvoiceFiscalRecordSequence {
  organizationId String       @id @db.Uuid
  nextValue      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model InvoiceFiscalRecord {
  id               String                  @id @default(uuid()) @db.Uuid
  invoiceId        String                  @db.Uuid
  organizationId   String                  @db.Uuid
  type             InvoiceFiscalRecordType
  sequenceNumber   Int
  previousRecordId String?                 @unique @db.Uuid
  previousHash     String?
  hash             String
  hashInput        Json
  hashVersion      String                  @default("internal-v1")
  createdByUserId  String?
  createdAt        DateTime                @default(now())

  invoice        Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  previousRecord InvoiceFiscalRecord? @relation("InvoiceFiscalRecordChain", fields: [previousRecordId], references: [id], onDelete: Restrict)
  nextRecord     InvoiceFiscalRecord? @relation("InvoiceFiscalRecordChain")
  createdByUser  User?                @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  verifactuRecord VerifactuRecord?

  // MVP constraint: one ALTA and one ANULACION per invoice. Revisit when
  // corrections, substitutions, or reprocessing workflows are introduced.
  @@unique([invoiceId, type])
  @@unique([organizationId, sequenceNumber])
  @@index([invoiceId])
  @@index([organizationId, createdAt])
  @@index([createdByUserId])
}

model VerifactuRecord {
  id                             String                  @id @default(uuid()) @db.Uuid
  invoiceFiscalRecordId          String                  @unique @db.Uuid
  invoiceId                      String                  @db.Uuid
  organizationId                 String                  @db.Uuid
  recordType                     InvoiceFiscalRecordType
  sellerTaxId                    String
  invoiceNumber                  String
  issueDate                      DateTime
  previousVerifactuRecordId      String?                 @unique @db.Uuid
  previousSellerTaxId            String?
  previousInvoiceNumber          String?
  previousIssueDate              DateTime?
  previousHuella                 String?
  huella                         String
  generationDateTimeWithTimezone String
  payloadVersion                 String
  xml                            String
  status                         VerifactuRecordStatus   @default(GENERATED)
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt

  invoiceFiscalRecord     InvoiceFiscalRecord @relation(fields: [invoiceFiscalRecordId], references: [id], onDelete: Restrict)
  invoice                 Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  previousVerifactuRecord VerifactuRecord?     @relation("VerifactuRecordChain", fields: [previousVerifactuRecordId], references: [id], onDelete: Restrict)
  nextVerifactuRecord     VerifactuRecord?     @relation("VerifactuRecordChain")

  @@unique([organizationId, huella])
  @@index([invoiceId])
  @@index([organizationId, createdAt])
  @@index([status])
}

model InvoiceSnapshot {
  invoiceId              String   @id @db.Uuid
  customerName           String
  customerEmail          String?
  customerTaxId          String?
  customerAddressLine1   String?
  customerCity           String?
  customerCountry        String?
  sellerName             String
  sellerLegalName        String?
  sellerTaxId            String?
  sellerAddressLine1     String?
  sellerCity             String?
  sellerCountry          String?
  paymentInstructions    String?
  subtotalCents          Int
  discountCents          Int
  taxCents               Int
  withholdingType        String?
  withholdingRate        Decimal? @db.Decimal(5, 2)
  withholdingAmountCents Int?
  totalCents             Int
  createdAt              DateTime @default(now())
  invoice                Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceLine {
  id                   String   @id @default(uuid()) @db.Uuid
  invoiceId            String   @db.Uuid
  description          String
  quantity             Decimal  @db.Decimal(12, 2)
  unitPriceCents       Int
  discountCents        Int      @default(0)
  invoiceDiscountCents Int      @default(0)
  taxRateBps           Int      @default(0)
  taxCents             Int      @default(0)
  totalCents           Int
  createdAt            DateTime @default(now())
  invoice              Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  amountCents Int
  paidAt      DateTime
  reference   String?
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoicePublicAccessToken {
  id             String    @id @default(uuid()) @db.Uuid
  invoiceId      String    @db.Uuid
  organizationId String    @db.Uuid
  tokenHash      String    @unique
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invoice      Invoice                @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   InvoiceEmailDelivery[]

  @@index([invoiceId])
  @@index([organizationId])
  @@index([revokedAt])
}

model InvoiceEmailDelivery {
  id                  String                     @id @default(uuid()) @db.Uuid
  invoiceId           String                     @db.Uuid
  organizationId      String                     @db.Uuid
  publicAccessTokenId String?                    @db.Uuid
  toEmail             String
  subject             String
  provider            String                     @default("postmark")
  providerMessageId   String?
  status              InvoiceEmailDeliveryStatus @default(PENDING)
  errorMessage        String?
  metadata            Json?
  sentAt              DateTime?
  deliveredAt         DateTime?
  failedAt            DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  invoice           Invoice                   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publicAccessToken InvoicePublicAccessToken? @relation(fields: [publicAccessTokenId], references: [id], onDelete: SetNull)
  events            InvoiceEmailEvent[]

  @@index([invoiceId])
  @@index([organizationId])
  @@index([providerMessageId])
  @@index([status])
}

model InvoiceEmailEvent {
  id                String   @id @default(uuid()) @db.Uuid
  deliveryId        String?  @db.Uuid
  provider          String   @default("postmark")
  providerMessageId String?
  recordType        String
  payload           Json
  createdAt         DateTime @default(now())

  delivery InvoiceEmailDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@index([deliveryId])
  @@index([providerMessageId])
  @@index([recordType])
}
