generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String?
  taxId        String?
  addressLine1 String?
  city         String?
  country      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  invoices     Invoice[]

  @@index([name])
}

model Invoice {
  id            String         @id @default(uuid()) @db.Uuid
  number        String         @unique
  status        InvoiceStatus  @default(DRAFT)
  customerId    String         @db.Uuid
  issueDate     DateTime
  dueDate       DateTime
  subtotalCents Int
  taxCents      Int            @default(0)
  totalCents    Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines         InvoiceLine[]
  payments      Payment[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceLine {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @db.Uuid
  description    String
  quantity       Decimal  @db.Decimal(12, 2)
  unitPriceCents Int
  totalCents     Int
  createdAt      DateTime @default(now())
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  amountCents Int
  paidAt      DateTime
  reference   String?
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
