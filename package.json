{
  "name": "asienta",
  "version": "0.1.5",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently -k -n css,js,server \"pnpm dev:css\" \"pnpm dev:js\" \"pnpm dev:server\"",
    "dev:css": "tailwindcss -i ./src/public/css/app.css -o ./public/assets/app.css --watch",
    "dev:js": "esbuild ./src/public/js/app.ts --bundle --outfile=./public/assets/app.js --sourcemap --watch",
    "dev:server": "tsx watch src/server.ts",
    "build": "pnpm build:css && pnpm build:js && tsc",
    "build:css": "tailwindcss -i ./src/public/css/app.css -o ./public/assets/app.css --minify",
    "build:js": "esbuild ./src/public/js/app.ts --bundle --outfile=./public/assets/app.js --minify",
    "start": "node dist/server.js",
    "test": "NODE_ENV=test DATABASE_URL=postgresql://test:test@localhost:5432/test pnpm build && NODE_ENV=test DATABASE_URL=postgresql://test:test@localhost:5432/test node --test \"dist/**/*.test.js\"",
    "test:e2e": "node scripts/test-e2e.mjs",
    "db:test:setup": "node scripts/setup-test-db.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "ngrok": "ngrok http --url=crawfish-jogger-epidemic.ngrok-free.dev 3000"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-flash": "^0.1.1",
    "cookie-parser": "~1.4.7",
    "dotenv": "^17.4.2",
    "express": "~5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "morgan": "~1.9.1",
    "nunjucks": "^3.2.4",
    "pg": "^8.21.0",
    "playwright": "^1.60.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/cli": "^4.3.0",
    "@types/compression": "^1.8.1",
    "@types/connect-flash": "^0.0.40",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.19.19",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}