<main class="invoice-page">
  <header class="flex items-center justify-between gap-8 border-b border-line pb-8">
    <div>
      <p class="text-sm font-medium uppercase tracking-wide text-muted">Invoice</p>
      <h1 class="mt-2 text-3xl font-semibold">{{ invoice.number }}</h1>
    </div>
    <div class="text-right text-sm">
      <p class="font-semibold">{{ snapshot.sellerLegalName or snapshot.sellerName }}</p>
    </div>
  </header>

  <section class="mt-8 grid gap-8 sm:grid-cols-2">
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Seller</h2>
      <div class="mt-3 space-y-1 text-sm">
        <p class="font-medium">{{ snapshot.sellerLegalName or snapshot.sellerName }}</p>
        {% if snapshot.sellerTaxId %}<p class="text-muted">Tax ID: {{ snapshot.sellerTaxId }}</p>{% endif %}
        {% if snapshot.sellerAddressLine1 %}<p class="text-muted">{{ snapshot.sellerAddressLine1 }}</p>{% endif %}
        {% if snapshot.sellerCity or snapshot.sellerCountry %}
          <p class="text-muted">{{ snapshot.sellerCity or '' }}{% if snapshot.sellerCity and snapshot.sellerCountry %}, {% endif %}{{ snapshot.sellerCountry or '' }}</p>
        {% endif %}
      </div>
    </div>
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Customer</h2>
      <div class="mt-3 space-y-1 text-sm">
        <p class="font-medium">{{ snapshot.customerName }}</p>
        {% if snapshot.customerEmail %}<p class="text-muted">{{ snapshot.customerEmail }}</p>{% endif %}
        {% if snapshot.customerTaxId %}<p class="text-muted">Tax ID: {{ snapshot.customerTaxId }}</p>{% endif %}
        {% if snapshot.customerAddressLine1 %}<p class="text-muted">{{ snapshot.customerAddressLine1 }}</p>{% endif %}
        {% if snapshot.customerCity or snapshot.customerCountry %}
          <p class="text-muted">{{ snapshot.customerCity or '' }}{% if snapshot.customerCity and snapshot.customerCountry %}, {% endif %}{{ snapshot.customerCountry or '' }}</p>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="mt-6 max-w-sm text-sm">
    <dl class="space-y-1">
      <div class="grid grid-cols-[120px_1fr] gap-4">
        <dt class="text-muted">Invoice Number:</dt>
        <dd class="font-semibold">{{ invoice.number }}</dd>
      </div>
      <div class="grid grid-cols-[120px_1fr] gap-4">
        <dt class="text-muted">Issue Date:</dt>
        <dd class="font-semibold">{{ invoice.issueDate | date }}</dd>
      </div>
      <div class="grid grid-cols-[120px_1fr] gap-4">
        <dt class="text-muted">Due Date:</dt>
        <dd class="font-semibold">{{ invoice.dueDate | date }}</dd>
      </div>
    </dl>
  </section>

  <section class="mt-6">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr class="border-b border-line text-left text-muted">
          <th class="py-3 pr-4 font-medium">Description</th>
          <th class="px-4 py-3 text-right font-medium">Qty</th>
          <th class="px-4 py-3 text-right font-medium">Unit Price</th>
          <th class="px-4 py-3 text-right font-medium">Discount</th>
          <th class="px-4 py-3 text-right font-medium">Net</th>
          <th class="px-4 py-3 text-right font-medium">Tax</th>
          <th class="py-3 pl-4 text-right font-medium">Total</th>
        </tr>
      </thead>
      <tbody>
        {% for line in invoiceLineDisplays %}
          <tr class="border-b border-line">
            <td class="py-4 pr-4 font-medium">{{ line.description }}</td>
            <td class="px-4 py-4 text-right text-muted">{{ line.quantity }}</td>
            <td class="px-4 py-4 text-right">{{ line.unitPriceCents | money(invoiceDisplay.currency, currentOrganization.locale) }}</td>
            <td class="px-4 py-4 text-right">{{ line.discountCents | money(invoiceDisplay.currency, currentOrganization.locale) }}</td>
            <td class="px-4 py-4 text-right">{{ line.netCents | money(invoiceDisplay.currency, currentOrganization.locale) }}</td>
            <td class="px-4 py-4 text-right">{{ line.taxCents | money(invoiceDisplay.currency, currentOrganization.locale) }} <span class="text-muted">({{ line.taxRateLabel }})</span></td>
            <td class="py-4 pl-4 text-right font-medium">{{ line.displayTotalCents | money(invoiceDisplay.currency, currentOrganization.locale) }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  <section class="mt-8 flex justify-end">
    <div class="w-full max-w-xs space-y-3 text-sm">
      <div class="flex justify-between gap-4">
        <span class="text-muted">Subtotal</span>
        <span class="font-medium">{{ snapshot.subtotalCents | money(invoiceDisplay.currency, currentOrganization.locale) }}</span>
      </div>
      <div class="flex justify-between gap-4">
        <span class="text-muted">Discount</span>
        <span class="font-medium">-{{ snapshot.discountCents | money(invoiceDisplay.currency, currentOrganization.locale) }}</span>
      </div>
      <div class="flex justify-between gap-4">
        <span class="text-muted">Tax</span>
        <span class="font-medium">{{ snapshot.taxCents | money(invoiceDisplay.currency, currentOrganization.locale) }}</span>
      </div>
      <div class="flex justify-between gap-4 border-t border-line pt-3 text-base">
        <span class="font-semibold">Invoice Total</span>
        <span class="font-semibold">{{ snapshot.totalCents | money(invoiceDisplay.currency, currentOrganization.locale) }}</span>
      </div>
      <div class="flex justify-between gap-4">
        <span class="text-muted">Amount Paid</span>
        <span class="font-medium">{{ paymentSummary.paidCents | money(invoiceDisplay.currency, currentOrganization.locale) }}</span>
      </div>
      <div class="flex justify-between gap-4">
        <span class="font-semibold">Outstanding</span>
        <span class="font-semibold">{{ paymentSummary.outstandingCents | money(invoiceDisplay.currency, currentOrganization.locale) }}</span>
      </div>
    </div>
  </section>

  {% if snapshot.paymentInstructions %}
    <section class="mt-10 border-t border-line pt-6">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Payment instructions</h2>
      <p class="mt-3 whitespace-pre-line text-sm text-ink">{{ snapshot.paymentInstructions }}</p>
    </section>
  {% endif %}
</main>
