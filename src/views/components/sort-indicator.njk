{% macro sortIndicator(sortLink) %}
  {% if sortLink.isCurrent %}
    <span class="inline-flex text-ink" aria-label="Sorted {{ sortLink.direction }}">
      {% if sortLink.direction == 'asc' %}
        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 12.5L10 7.5L15 12.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {% else %}
        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {% endif %}
    </span>
  {% endif %}
{% endmacro %}
