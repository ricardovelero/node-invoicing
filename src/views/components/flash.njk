{% if flash.success.length %}
  <div
    data-auto-dismiss="3500"
    class="fixed right-6 top-6 z-50 rounded-md border border-action/25 bg-action px-4 py-3 text-sm text-white shadow-lg">
    {{ flash.success[0] }}
  </div>
{% endif %}

{% if flash.error.length %}
  <div
    data-auto-dismiss="4500"
    class="fixed right-6 top-6 z-50 rounded-md border border-red-200 bg-red-600 px-4 py-3 text-sm text-white shadow-lg">
    {{ flash.error[0] }}
  </div>
{% endif %}
