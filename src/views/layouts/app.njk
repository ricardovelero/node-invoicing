<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} | Invoicing</title>
    <link rel="stylesheet" href="/assets/app.css">
    <script defer src="/assets/app.js"></script>
  </head>
  <body>
    <div class="min-h-screen">
      <header class="border-b border-line bg-white">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
          <a href="/" class="text-lg font-semibold tracking-normal text-ink">Invoicing</a>
          <nav class="flex items-center gap-1 text-sm">
            <a class="rounded-md px-3 py-2 font-medium {{ 'bg-panel text-ink' if currentPath == '/' else 'text-muted hover:text-ink' }}" href="/">Dashboard</a>
            <a class="rounded-md px-3 py-2 font-medium {{ 'bg-panel text-ink' if currentPath.startsWith('/customers') else 'text-muted hover:text-ink' }}" href="/customers">Customers</a>
            <a class="rounded-md px-3 py-2 font-medium {{ 'bg-panel text-ink' if currentPath.startsWith('/invoices') else 'text-muted hover:text-ink' }}" href="/invoices">Invoices</a>
          </nav>
        </div>
      </header>

      <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
        {% include "components/flash.njk" %}
        {% block content %}{% endblock %}
      </main>
    </div>
  </body>
</html>
