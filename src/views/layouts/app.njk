<!doctype html>
<html lang="{{ currentLanguage or 'en-gb' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} | {{ t('common.app.name') }}</title>
    <link rel="icon" href="/assets/favicon.ico" sizes="any">
    <link rel="stylesheet" href="/assets/app.css">
    <script defer src="/assets/app.js"></script>
  </head>
  <body>
    <div class="min-h-screen">
      <header class="border-b border-line bg-white">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
          <a href="/" class="inline-flex items-center">
            <img class="h-9 w-auto" src="/assets/asienta-logo-horizontal.webp" alt="{{ t('common.app.name') }}">
          </a>
          {% if currentUser %}
            <nav class="flex items-center gap-1 text-sm">
              <a class="rounded-md px-3 py-2 font-medium {{ 'bg-panel text-ink' if currentPath == '/' else 'text-muted hover:text-ink' }}" href="/">{{ t('common.navigation.dashboard') }}</a>
              <a class="rounded-md px-3 py-2 font-medium {{ 'bg-panel text-ink' if currentPath.startsWith('/invoices') else 'text-muted hover:text-ink' }}" href="/invoices">{{ t('common.navigation.invoices') }}</a>
              <a class="rounded-md px-3 py-2 font-medium {{ 'bg-panel text-ink' if currentPath.startsWith('/customers') else 'text-muted hover:text-ink' }}" href="/customers">{{ t('common.navigation.customers') }}</a>
              <a class="rounded-md px-3 py-2 font-medium {{ 'bg-panel text-ink' if currentPath.startsWith('/items') else 'text-muted hover:text-ink' }}" href="/items">{{ t('common.navigation.items') }}</a>
              <a class="rounded-md px-3 py-2 font-medium {{ 'bg-panel text-ink' if currentPath.startsWith('/settings') else 'text-muted hover:text-ink' }}" href="/settings">{{ t('common.navigation.settings') }}</a>
              
              {% if availableOrganizations and availableOrganizations.length > 1 %}
                <details class="group relative">
                  <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-line px-3 py-2 text-sm font-medium transition-colors hover:bg-panel focus:outline-none focus-visible:ring-2 focus-visible:ring-ink/20 [&::-webkit-details-marker]:hidden">
                    <span>{{ currentOrganization.name }}</span>
                    <svg class="h-4 w-4 text-muted transition-transform group-open:rotate-180" aria-hidden="true" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
                    </svg>
                  </summary>
                  <div class="organization-menu absolute right-0 z-50 mt-2 w-56 origin-top-right rounded-md border border-line bg-white p-2 shadow-lg ring-1 ring-black/5">
                    {% for organization in availableOrganizations %}
                      <form method="post" action="/settings/organizations/switch">
                        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                        <input type="hidden" name="returnTo" value="{{ currentPath }}">
                        <input type="hidden" name="organizationId" value="{{ organization.id }}">

                        <button type="submit" class="w-full cursor-pointer rounded-md px-3 py-2 text-left text-sm hover:bg-panel {{ 'font-semibold text-ink' if organization.isCurrent else 'text-muted' }}">
                          {{ organization.name }}
                          {% if organization.isCurrent %}✓{% endif %}
                        </button>
                      </form>
                    {% endfor %}

                    <a href="/settings/organizations" class="mt-2 block border-t border-line px-3 py-2 text-sm text-muted hover:text-ink">
                      {{ t('settings.organizations.manage') }}
                    </a>
                  </div>
                </details>
              {% endif %}

              <form method="post" action="/auth/logout">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <button class="btn btn-link" type="submit">{{ t('common.actions.logout') }}</button>
              </form>
            </nav>
          {% endif %}
        </div>
      </header>

      <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
        {% include "components/flash.njk" %}
        {% block content %}{% endblock %}
      </main>
    </div>
  </body>
</html>
