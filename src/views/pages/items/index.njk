{% extends "layouts/app.njk" %}
{% from "components/sort-indicator.njk" import sortIndicator %}

{% block content %}
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-medium text-muted">{{ t('items.section') }}</p>
      <h1 class="mt-1 text-3xl font-semibold">{{ t('items.archivedTitle') if showingArchived else t('items.title') }}</h1>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      {% if showingArchived %}
        <a class="text-sm font-medium text-muted hover:text-ink" href="{{ activeItemsHref }}">{{ t('items.actions.active') }}</a>
      {% else %}
        <a class="btn btn-link" href="{{ archivedItemsHref }}">{{ t('items.actions.archived') }}</a>
      {% endif %}
      <a href="/items/new" class="btn btn-primary">{{ t('items.actions.new') }}</a>
    </div>
  </div>

  <form class="mb-4 rounded-lg border border-line bg-white p-4" method="get" action="/items">
    <input type="hidden" name="page" value="1">
    <input type="hidden" name="sort" value="{{ filters.sort }}">
    <input type="hidden" name="direction" value="{{ filters.direction }}">
    <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_12rem_8rem_auto] md:items-end">
      <label class="block">
        <span class="text-sm font-medium text-ink">{{ t('items.filters.search') }}</span>
        <input class="mt-1 block w-full rounded-md border border-line px-3 py-2 text-sm shadow-sm focus:border-action focus:outline-none focus:ring-1 focus:ring-action" type="search" name="q" value="{{ filters.q }}" placeholder="{{ t('items.filters.searchPlaceholder') }}">
      </label>

      <label class="block">
        <span class="text-sm font-medium text-ink">{{ t('items.filters.status') }}</span>
        <select class="mt-1 block w-full rounded-md border border-line px-3 py-2 text-sm shadow-sm focus:border-action focus:outline-none focus:ring-1 focus:ring-action" name="archived">
          {% for option in archivedOptions %}
            <option value="{{ option.value }}" {% if option.selected %}selected{% endif %}>{{ option.label }}</option>
          {% endfor %}
        </select>
      </label>

      <label class="block">
        <span class="text-sm font-medium text-ink">{{ t('items.filters.rows') }}</span>
        <select class="mt-1 block w-full rounded-md border border-line px-3 py-2 text-sm shadow-sm focus:border-action focus:outline-none focus:ring-1 focus:ring-action" name="limit">
          {% for option in limitOptions %}
            <option value="{{ option.value }}" {% if option.selected %}selected{% endif %}>{{ option.label }}</option>
          {% endfor %}
        </select>
      </label>

      <div class="flex gap-3">
        <button class="btn btn-primary" type="submit">{{ t('common.actions.apply') }}</button>
        {% if hasActiveFilters %}
          <a class="btn btn-secondary" href="/items">{{ t('common.actions.clear') }}</a>
        {% endif %}
      </div>
    </div>
  </form>

  <div class="overflow-hidden rounded-lg border border-line bg-white">
    <table class="min-w-full divide-y divide-line text-sm">
      <thead class="bg-panel text-left text-muted">
        <tr>
          <th class="px-4 py-3 font-medium">
            <a class="inline-flex items-center gap-1 text-muted hover:text-ink" href="{{ sortLinks.name.href }}">
              {{ t('common.table.name') }}
              {{ sortIndicator(sortLinks.name) }}
            </a>
          </th>
          <th class="px-4 py-3 font-medium">{{ t('items.table.description') }}</th>
          <th class="px-4 py-3 text-right font-medium">
            <a class="inline-flex items-center gap-1 text-muted hover:text-ink" href="{{ sortLinks.unitPriceCents.href }}">
              {{ t('items.table.unitPrice') }}
              {{ sortIndicator(sortLinks.unitPriceCents) }}
            </a>
          </th>
          <th class="px-4 py-3 text-right font-medium">
            <a class="inline-flex items-center gap-1 text-muted hover:text-ink" href="{{ sortLinks.taxRateBps.href }}">
              {{ t('items.table.taxRate') }}
              {{ sortIndicator(sortLinks.taxRateBps) }}
            </a>
          </th>
          <th class="px-4 py-3 font-medium">
            <a class="inline-flex items-center gap-1 text-muted hover:text-ink" href="{{ sortLinks.createdAt.href }}">
              {{ t('common.table.created') }}
              {{ sortIndicator(sortLinks.createdAt) }}
            </a>
          </th>
          <th class="px-4 py-3 text-right font-medium">{{ t('items.table.actions') }}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        {% for item in items %}
          <tr>
            <td class="px-4 py-3 font-medium">
              <a class="text-action hover:text-action-dark" href="/items/{{ item.id }}/edit">{{ item.name }}</a>
              {% if item.archivedAt %}
                <span class="ml-2 rounded-full bg-panel px-2 py-0.5 text-xs font-medium text-muted">{{ t('items.table.archivedBadge') }}</span>
              {% endif %}
            </td>
            <td class="px-4 py-3 text-muted">{{ item.description or '—' }}</td>
            <td class="px-4 py-3 text-right">{{ item.unitPriceCents | money(item.currency, currentLocale) }}</td>
            <td class="px-4 py-3 text-right text-muted">{{ item.taxRateLabel }}</td>
            <td class="px-4 py-3 text-muted">{{ item.createdAt | date(currentLocale) }}</td>
            <td class="px-4 py-3">
              <div class="flex justify-end gap-3">
                <a class="text-sm font-medium text-action hover:text-action-dark" href="/items/{{ item.id }}/edit">{{ t('items.actions.edit') }}</a>
                {% if item.archivedAt %}
                  <form method="post" action="/items/{{ item.id }}/restore">
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                    <button class="text-sm font-medium text-action hover:text-action-dark" type="submit">{{ t('items.actions.restore') }}</button>
                  </form>
                {% else %}
                  <form method="post" action="/items/{{ item.id }}/archive">
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                    <button class="text-sm font-medium text-muted hover:text-ink" type="submit">{{ t('items.actions.archive') }}</button>
                  </form>
                {% endif %}
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td class="px-4 py-6 text-muted" colspan="6">{{ emptyMessage }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex flex-col gap-3 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>
      {{ t('common.pagination.pageStatus', { page: pagination.page, totalPages: pagination.totalPages }) }}
      <span class="ml-1">{{ t('common.pagination.totalCount', { count: pagination.totalCount, label: t('items.pagination.countLabel') }) }}</span>
    </p>
    <nav class="flex flex-wrap items-center gap-2" aria-label="{{ t('items.pagination.ariaLabel') }}">
      {% if pagination.previousHref %}
        <a class="rounded-md border border-line px-3 py-2 font-medium text-muted hover:text-ink" href="{{ pagination.previousHref }}">{{ t('common.actions.previous') }}</a>
      {% else %}
        <span class="rounded-md border border-line px-3 py-2 font-medium text-muted opacity-50">{{ t('common.actions.previous') }}</span>
      {% endif %}

      {% for pageLink in pagination.pages %}
        {% if pageLink.isCurrent %}
          <span class="rounded-md bg-action px-3 py-2 font-semibold text-white">{{ pageLink.page }}</span>
        {% else %}
          <a class="rounded-md border border-line px-3 py-2 font-medium text-muted hover:text-ink" href="{{ pageLink.href }}">{{ pageLink.page }}</a>
        {% endif %}
      {% endfor %}

      {% if pagination.nextHref %}
        <a class="rounded-md border border-line px-3 py-2 font-medium text-muted hover:text-ink" href="{{ pagination.nextHref }}">{{ t('common.actions.next') }}</a>
      {% else %}
        <span class="rounded-md border border-line px-3 py-2 font-medium text-muted opacity-50">{{ t('common.actions.next') }}</span>
      {% endif %}
    </nav>
  </div>
{% endblock %}
