{% extends "layouts/app.njk" %}
{% from "components/badge.njk" import badge %}

{% macro moneyStack(totals, sizeClass = 'text-3xl') %}
  <div class="space-y-1">
    {% for total in totals %}
      <p class="{{ sizeClass }} font-semibold text-ink">{{ total.totalCents | money(total.currency, currentLocale) }}</p>
    {% endfor %}
  </div>
{% endmacro %}

{% block content %}
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-medium text-muted">{{ t('dashboard.section') }}</p>
      <h1 class="mt-1 text-3xl font-semibold text-ink">{{ t('dashboard.title') }}</h1>
    </div>
    <a href="/invoices/new" class="btn btn-primary">{{ t('dashboard.actions.newInvoice') }}</a>
  </div>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="{{ t('dashboard.kpis.ariaLabel') }}">
    <div class="card card-body">
      <p class="text-sm font-medium text-muted">{{ t('dashboard.kpis.totalInvoicedThisMonth') }}</p>
      <div class="mt-3">{{ moneyStack(metrics.totalInvoicedThisMonth) }}</div>
    </div>
    <div class="card card-body">
      <p class="text-sm font-medium text-muted">{{ t('dashboard.kpis.paidThisMonth') }}</p>
      <div class="mt-3">{{ moneyStack(metrics.paidThisMonth) }}</div>
    </div>
    <div class="card card-body">
      <p class="text-sm font-medium text-muted">{{ t('dashboard.kpis.outstandingBalance') }}</p>
      <div class="mt-3">{{ moneyStack(metrics.outstandingBalance) }}</div>
    </div>
    <div class="card card-body">
      <p class="text-sm font-medium text-muted">{{ t('dashboard.kpis.overdueAmount') }}</p>
      <div class="mt-3">{{ moneyStack(metrics.overdueAmount) }}</div>
    </div>
  </section>

  <section class="mt-6 card card-body">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-medium text-muted">{{ t('dashboard.quickActions.section') }}</p>
        <h2 class="mt-1 text-lg font-semibold">{{ t('dashboard.quickActions.title') }}</h2>
      </div>
      <a class="text-sm font-medium text-action hover:text-action-dark" href="/invoices">{{ t('dashboard.actions.viewAllInvoices') }}</a>
    </div>
    <div class="mt-4 grid gap-3 md:grid-cols-4">
      {% for action in quickActions %}
        <a class="rounded-md border border-line bg-white p-4 transition hover:border-action hover:shadow-sm" href="{{ action.href }}">
          <span class="btn {{ 'btn-primary' if action.variant == 'primary' else 'btn-secondary' }} btn-full">{{ t(action.labelKey) }}</span>
          <span class="mt-3 block text-sm text-muted">{{ t(action.descriptionKey, action.descriptionParams) }}</span>
        </a>
      {% endfor %}
    </div>
  </section>

  <div class="mt-8 grid gap-6 xl:grid-cols-[minmax(0,1.35fr)_minmax(22rem,0.65fr)]">
    <section class="card card-body">
      <div class="mb-4 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-medium text-muted">{{ t('dashboard.attention.section') }}</p>
          <h2 class="mt-1 text-lg font-semibold">{{ t('dashboard.attention.title') }}</h2>
        </div>
        <a class="text-sm font-medium text-action hover:text-action-dark" href="/invoices">{{ t('dashboard.actions.openInvoiceList') }}</a>
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        {% for section in attentionSections %}
          <div class="rounded-md border border-line">
            <div class="flex items-center justify-between gap-3 border-b border-line bg-panel px-4 py-3">
              <h3 class="text-sm font-semibold">{{ t(section.titleKey) }}</h3>
              <a class="text-xs font-medium text-action hover:text-action-dark" href="{{ section.href }}">{{ t('dashboard.actions.view') }}</a>
            </div>
            <div class="divide-y divide-line">
              {% for invoice in section.rows %}
                <a class="block px-4 py-3 transition hover:bg-panel" href="/invoices/{{ invoice.id }}">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p class="truncate text-sm font-semibold text-action">{{ invoice.number }}</p>
                      <p class="mt-0.5 truncate text-sm text-muted">{{ invoice.customerName }}</p>
                    </div>
                    <div class="flex flex-wrap justify-end gap-2">
                      {% for statusBadge in invoice.statusBadges %}
                        {{ badge(statusBadge.label, statusBadge.variant) }}
                      {% endfor %}
                    </div>
                  </div>
                  <div class="mt-2 flex items-center justify-between gap-3 text-sm">
                    <span class="text-muted">{{ t('dashboard.attention.duePrefix') }} {{ invoice.dueDate | date(currentLocale) }}</span>
                    <span class="font-medium">{{ invoice.outstandingCents | money(invoice.currency, currentLocale) }}</span>
                  </div>
                </a>
              {% else %}
                <div class="px-4 py-5">
                  <p class="text-sm text-muted">{{ t(section.emptyMessageKey) }}</p>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <section class="card card-body">
      <div>
        <p class="text-sm font-medium text-muted">{{ t('dashboard.monthly.section') }}</p>
        <h2 class="mt-1 text-lg font-semibold">{{ t('dashboard.monthly.title') }}</h2>
      </div>
      <div class="mt-5 space-y-5">
        {% for month in monthlySeries %}
          <div>
            <div class="mb-2 flex items-center justify-between gap-3">
              <h3 class="text-sm font-semibold">{{ month.label }}</h3>
              <div class="text-right text-xs text-muted">
                {% for total in month.invoicedTotals %}
                  <span>{{ t('dashboard.monthly.invoiced') }} {{ total.totalCents | money(total.currency, currentLocale) }}</span>{% if not loop.last %}<br>{% endif %}
                {% endfor %}
              </div>
            </div>
            <div class="space-y-2">
              <div>
                <div class="mb-1 flex items-center justify-between text-xs text-muted">
                  <span>{{ t('dashboard.monthly.invoiced') }}</span>
                  {% for total in month.invoicedTotals %}
                    <span>{{ total.totalCents | money(total.currency, currentLocale) }}</span>
                  {% endfor %}
                </div>
                <div class="h-2 rounded-full bg-panel">
                  <div class="h-2 rounded-full bg-action" style="width: {{ month.invoicedBarWidth }}%;"></div>
                </div>
              </div>
              <div>
                <div class="mb-1 flex items-center justify-between text-xs text-muted">
                  <span>{{ t('dashboard.monthly.paid') }}</span>
                  {% for total in month.paidTotals %}
                    <span>{{ total.totalCents | money(total.currency, currentLocale) }}</span>
                  {% endfor %}
                </div>
                <div class="h-2 rounded-full bg-panel">
                  <div class="h-2 rounded-full bg-emerald-500" style="width: {{ month.paidBarWidth }}%;"></div>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </section>
  </div>

  <section class="mt-6 card card-body">
    <div class="mb-4">
      <p class="text-sm font-medium text-muted">{{ t('dashboard.activity.section') }}</p>
      <h2 class="mt-1 text-lg font-semibold">{{ t('dashboard.activity.title') }}</h2>
    </div>
    <div class="overflow-hidden rounded-md border border-line">
      <table class="min-w-full divide-y divide-line text-sm">
        <thead class="bg-panel text-left text-muted">
          <tr>
            <th class="px-4 py-3 font-medium">{{ t('dashboard.activity.table.activity') }}</th>
            <th class="px-4 py-3 font-medium">{{ t('dashboard.activity.table.invoice') }}</th>
            <th class="px-4 py-3 font-medium">{{ t('dashboard.activity.table.customer') }}</th>
            <th class="px-4 py-3 text-right font-medium">{{ t('dashboard.activity.table.amount') }}</th>
            <th class="px-4 py-3 font-medium">{{ t('dashboard.activity.table.date') }}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {% for activity in recentActivity %}
            <tr>
              <td class="px-4 py-3 font-medium">{{ t('dashboard.activity.types.' + activity.type) }}</td>
              <td class="px-4 py-3">
                <a class="font-medium text-action hover:text-action-dark" href="{{ activity.href }}">{{ activity.invoiceNumber }}</a>
              </td>
              <td class="px-4 py-3 text-muted">{{ activity.customerName }}</td>
              <td class="px-4 py-3 text-right">{{ activity.amountCents | money(activity.currency, currentLocale) }}</td>
              <td class="px-4 py-3 text-muted">{{ activity.occurredAt | date(currentLocale) }}</td>
            </tr>
          {% else %}
            <tr>
              <td class="px-4 py-6 text-muted" colspan="5">{{ t('dashboard.activity.empty') }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endblock %}
