{% extends "layouts/app.njk" %}

{% block content %}
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-medium text-muted">Overview</p>
      <h1 class="mt-1 text-3xl font-semibold text-ink">Dashboard</h1>
    </div>
    <a href="/invoices/new" class="inline-flex items-center justify-center rounded-md bg-action px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-action-dark">New invoice</a>
  </div>

  <section class="grid gap-4 md:grid-cols-3">
    <div class="rounded-lg border border-line bg-white p-5">
      <p class="text-sm text-muted">Customers</p>
      <p class="mt-3 text-3xl font-semibold">{{ metrics.customerCount }}</p>
    </div>
    <div class="rounded-lg border border-line bg-white p-5">
      <p class="text-sm text-muted">Invoices</p>
      <p class="mt-3 text-3xl font-semibold">{{ metrics.invoiceCount }}</p>
    </div>
    <div class="rounded-lg border border-line bg-white p-5">
      <p class="text-sm text-muted">Open balance</p>
      {% if metrics.openBalanceIsMixedCurrency %}
        <p class="mt-3 text-3xl font-semibold">Mixed currencies</p>
      {% else %}
        <p class="mt-3 text-3xl font-semibold">{{ metrics.openBalanceCents | money(metrics.openBalanceCurrency, currentOrganization.locale) }}</p>
      {% endif %}
    </div>
  </section>

  <section class="mt-8">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-lg font-semibold">Latest invoices</h2>
      <a href="/invoices" class="text-sm font-medium text-action hover:text-action-dark">View all</a>
    </div>
    <div class="overflow-hidden rounded-lg border border-line bg-white">
      <table class="min-w-full divide-y divide-line text-sm">
        <thead class="bg-panel text-left text-muted">
          <tr>
            <th class="px-4 py-3 font-medium">Number</th>
            <th class="px-4 py-3 font-medium">Customer</th>
            <th class="px-4 py-3 font-medium">Status</th>
            <th class="px-4 py-3 text-right font-medium">Total</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {% for invoice in latestInvoices %}
            {% set invoiceCustomerName = invoice.snapshot.customerName if invoice.status != 'DRAFT' and invoice.snapshot else invoice.customer.name %}
            <tr>
              <td class="px-4 py-3 font-medium">{{ invoice.number }}</td>
              <td class="px-4 py-3 text-muted">{{ invoiceCustomerName }}</td>
              <td class="px-4 py-3">{{ invoice.status }}</td>
              <td class="px-4 py-3 text-right">{{ invoice.totalCents | money(invoice.currency, currentOrganization.locale) }}</td>
            </tr>
          {% else %}
            <tr>
              <td class="px-4 py-6 text-muted" colspan="4">No invoices yet.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endblock %}
