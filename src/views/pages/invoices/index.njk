{% extends "layouts/app.njk" %}
{% from "components/badge.njk" import badge %}
{% from "components/sort-indicator.njk" import sortIndicator %}

{% block content %}
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-medium text-muted">Billing</p>
      <h1 class="mt-1 text-3xl font-semibold">Invoices</h1>
    </div>
    <a href="/invoices/new" class="btn btn-primary">New invoice</a>
  </div>

  <form class="mb-4 rounded-lg border border-line bg-white p-4" method="get" action="/invoices">
    <input type="hidden" name="page" value="1">
    <input type="hidden" name="sort" value="{{ filters.sort }}">
    <input type="hidden" name="direction" value="{{ filters.direction }}">
    <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_12rem_8rem_auto] md:items-end">
      <label class="block">
        <span class="text-sm font-medium text-ink">Search</span>
        <input class="mt-1 block w-full rounded-md border border-line px-3 py-2 text-sm shadow-sm focus:border-action focus:outline-none focus:ring-1 focus:ring-action" type="search" name="q" value="{{ filters.q }}" placeholder="Invoice number or customer">
      </label>

      <label class="block">
        <span class="text-sm font-medium text-ink">Status</span>
        <select class="mt-1 block w-full rounded-md border border-line px-3 py-2 text-sm shadow-sm focus:border-action focus:outline-none focus:ring-1 focus:ring-action" name="status">
          {% for option in statusOptions %}
            <option value="{{ option.value }}" {% if option.selected %}selected{% endif %}>{{ option.label }}</option>
          {% endfor %}
        </select>
      </label>

      <label class="block">
        <span class="text-sm font-medium text-ink">Rows</span>
        <select class="mt-1 block w-full rounded-md border border-line px-3 py-2 text-sm shadow-sm focus:border-action focus:outline-none focus:ring-1 focus:ring-action" name="limit">
          {% for option in limitOptions %}
            <option value="{{ option.value }}" {% if option.selected %}selected{% endif %}>{{ option.label }}</option>
          {% endfor %}
        </select>
      </label>

      <div class="flex gap-3">
        <button class="btn btn-primary" type="submit">Apply</button>
        {% if hasActiveFilters %}
          <a class="btn btn-secondary" href="/invoices">Clear</a>
        {% endif %}
      </div>
    </div>
  </form>

  <div class="overflow-hidden rounded-lg border border-line bg-white">
    <table class="min-w-full divide-y divide-line text-sm">
      <thead class="bg-panel text-left text-muted">
        <tr>
          <th class="px-4 py-3 font-medium">
            <a class="inline-flex items-center gap-1 text-muted hover:text-ink" href="{{ sortLinks.number.href }}">
              Number
              {{ sortIndicator(sortLinks.number) }}
            </a>
          </th>
          <th class="px-4 py-3 font-medium">Customer</th>
          <th class="px-4 py-3 font-medium">
            <a class="inline-flex items-center gap-1 text-muted hover:text-ink" href="{{ sortLinks.issueDate.href }}">
              Issue
              {{ sortIndicator(sortLinks.issueDate) }}
            </a>
          </th>
          <th class="px-4 py-3 font-medium">
            <a class="inline-flex items-center gap-1 text-muted hover:text-ink" href="{{ sortLinks.dueDate.href }}">
              Due
              {{ sortIndicator(sortLinks.dueDate) }}
            </a>
          </th>
          <th class="px-4 py-3 font-medium">
            <a class="inline-flex items-center gap-1 text-muted hover:text-ink" href="{{ sortLinks.status.href }}">
              Status
              {{ sortIndicator(sortLinks.status) }}
            </a>
          </th>
          <th class="px-4 py-3 text-right font-medium">
            <a class="inline-flex items-center gap-1 text-muted hover:text-ink" href="{{ sortLinks.totalCents.href }}">
              Total
              {{ sortIndicator(sortLinks.totalCents) }}
            </a>
          </th>
          <th class="px-4 py-3 font-medium">
            <a class="inline-flex items-center gap-1 text-muted hover:text-ink" href="{{ sortLinks.createdAt.href }}">
              Created
              {{ sortIndicator(sortLinks.createdAt) }}
            </a>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        {% for invoice in invoiceRows %}
          <tr>
            <td class="px-4 py-3 font-medium">
              <a class="text-action hover:text-action-dark" href="/invoices/{{ invoice.id }}">{{ invoice.number }}</a>
            </td>
            <td class="px-4 py-3 text-muted">{{ invoice.customerName }}</td>
            <td class="px-4 py-3 text-muted">{{ invoice.issueDate | date }}</td>
            <td class="px-4 py-3 text-muted">{{ invoice.dueDate | date }}</td>
            <td class="px-4 py-3">{{ badge(invoice.statusBadge.label, invoice.statusBadge.variant) }}</td>
            <td class="px-4 py-3 text-right">{{ invoice.totalCents | money(invoice.currency, currentOrganization.locale) }}</td>
            <td class="px-4 py-3 text-muted">{{ invoice.createdAt | date }}</td>
          </tr>
        {% else %}
          <tr>
            <td class="px-4 py-6 text-muted" colspan="7">{{ emptyMessage }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex flex-col gap-3 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>
      Page {{ pagination.page }} of {{ pagination.totalPages }}
      <span class="ml-1">({{ pagination.totalCount }} invoices)</span>
    </p>
    <nav class="flex flex-wrap items-center gap-2" aria-label="Invoice pagination">
      {% if pagination.previousHref %}
        <a class="rounded-md border border-line px-3 py-2 font-medium text-muted hover:text-ink" href="{{ pagination.previousHref }}">Previous</a>
      {% else %}
        <span class="rounded-md border border-line px-3 py-2 font-medium text-muted opacity-50">Previous</span>
      {% endif %}

      {% for pageLink in pagination.pages %}
        {% if pageLink.isCurrent %}
          <span class="rounded-md bg-action px-3 py-2 font-semibold text-white">{{ pageLink.page }}</span>
        {% else %}
          <a class="rounded-md border border-line px-3 py-2 font-medium text-muted hover:text-ink" href="{{ pageLink.href }}">{{ pageLink.page }}</a>
        {% endif %}
      {% endfor %}

      {% if pagination.nextHref %}
        <a class="rounded-md border border-line px-3 py-2 font-medium text-muted hover:text-ink" href="{{ pagination.nextHref }}">Next</a>
      {% else %}
        <span class="rounded-md border border-line px-3 py-2 font-medium text-muted opacity-50">Next</span>
      {% endif %}
    </nav>
  </div>
{% endblock %}
