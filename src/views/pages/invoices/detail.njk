{% extends "layouts/app.njk" %}

{% block content %}
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-muted">Invoice</p>
      <h1 class="mt-1 text-3xl font-semibold">{{ invoice.number }}</h1>
      <p class="mt-2 text-sm text-muted">
        <a class="text-action hover:text-action-dark" href="/customers/{{ invoice.customer.id }}">{{ invoice.customer.name }}</a>
      </p>
    </div>
    <a class="text-sm font-medium text-muted hover:text-ink" href="/invoices">Back to invoices</a>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1fr_320px]">
    <section class="space-y-6">
      <div class="rounded-lg border border-line bg-white p-6">
        <div class="grid gap-5 sm:grid-cols-3">
          <div>
            <p class="text-sm text-muted">Status</p>
            <p class="mt-1 font-semibold">{{ 'OVERDUE' if isEffectivelyOverdue else invoice.status }}</p>
            {% if isEffectivelyOverdue %}
              <p class="mt-1 text-xs text-muted">Stored as SENT</p>
            {% endif %}
          </div>
          <div>
            <p class="text-sm text-muted">Issue date</p>
            <p class="mt-1 font-semibold">{{ invoice.issueDate | date }}</p>
          </div>
          <div>
            <p class="text-sm text-muted">Due date</p>
            <p class="mt-1 font-semibold">{{ invoice.dueDate | date }}</p>
          </div>
        </div>
      </div>

      <div class="overflow-hidden rounded-lg border border-line bg-white">
        <table class="min-w-full divide-y divide-line text-sm">
          <thead class="bg-panel text-left text-muted">
            <tr>
              <th class="px-4 py-3 font-medium">Description</th>
              <th class="px-4 py-3 text-right font-medium">Qty</th>
              <th class="px-4 py-3 text-right font-medium">Unit</th>
              <th class="px-4 py-3 text-right font-medium">Discount</th>
              <th class="px-4 py-3 text-right font-medium">Tax</th>
              <th class="px-4 py-3 text-right font-medium">Line net</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {% for line in invoice.lines %}
              <tr>
                <td class="px-4 py-3 font-medium">{{ line.description }}</td>
                <td class="px-4 py-3 text-right text-muted">{{ line.quantity }}</td>
                <td class="px-4 py-3 text-right">{{ line.unitPriceCents | money(currentOrganization.currency) }}</td>
                <td class="px-4 py-3 text-right">{{ line.discountCents | money(currentOrganization.currency) }}</td>
                <td class="px-4 py-3 text-right">{{ line.taxCents | money(currentOrganization.currency) }}</td>
                <td class="px-4 py-3 text-right font-medium">{{ line.totalCents | money(currentOrganization.currency) }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% if invoice.notes %}
        <div class="rounded-lg border border-line bg-white p-6">
          <h2 class="text-lg font-semibold">Notes</h2>
          <p class="mt-3 whitespace-pre-line text-sm text-muted">{{ invoice.notes }}</p>
        </div>
      {% endif %}

      <div class="rounded-lg border border-line bg-white p-6">
        <h2 class="text-lg font-semibold">Payments</h2>
        <div class="mt-4 overflow-hidden rounded-md border border-line">
          <table class="min-w-full divide-y divide-line text-sm">
            <thead class="bg-panel text-left text-muted">
              <tr>
                <th class="px-4 py-3 font-medium">Paid</th>
                <th class="px-4 py-3 font-medium">Reference</th>
                <th class="px-4 py-3 text-right font-medium">Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {% for payment in invoice.payments %}
                <tr>
                  <td class="px-4 py-3">{{ payment.paidAt | date }}</td>
                  <td class="px-4 py-3 text-muted">{{ payment.reference or '—' }}</td>
                  <td class="px-4 py-3 text-right">{{ payment.amountCents | money(currentOrganization.currency) }}</td>
                </tr>
              {% else %}
                <tr>
                  <td class="px-4 py-6 text-muted" colspan="3">No payments recorded.</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <aside class="space-y-6">
      <div class="rounded-lg border border-line bg-white p-6">
        <h2 class="text-lg font-semibold">Totals</h2>
        <div class="mt-4 space-y-3 text-sm">
          <div class="flex justify-between gap-4">
            <span class="text-muted">Subtotal</span>
            <span class="font-medium">{{ invoice.subtotalCents | money(currentOrganization.currency) }}</span>
          </div>
          <div class="flex justify-between gap-4">
            <span class="text-muted">Invoice discount</span>
            <span class="font-medium">-{{ invoice.discountCents | money(currentOrganization.currency) }}</span>
          </div>
          <div class="flex justify-between gap-4">
            <span class="text-muted">Tax</span>
            <span class="font-medium">{{ invoice.taxCents | money(currentOrganization.currency) }}</span>
          </div>
          <div class="flex justify-between gap-4 border-t border-line pt-3 text-base">
            <span class="font-semibold">Total</span>
            <span class="font-semibold">{{ invoice.totalCents | money(currentOrganization.currency) }}</span>
          </div>
        </div>
      </div>

      <div class="rounded-lg border border-line bg-white p-6">
        <h2 class="text-lg font-semibold">Actions</h2>
        {% if allowedActions.length %}
          <div class="mt-4 space-y-3">
            {% if 'send' in allowedActions %}
              <form method="post" action="/invoices/{{ invoice.id }}/status">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <input type="hidden" name="action" value="send">
                <button class="w-full rounded-md bg-action px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-action-dark" type="submit">Mark sent</button>
              </form>
            {% endif %}

            {% if 'markOverdue' in allowedActions %}
              <form method="post" action="/invoices/{{ invoice.id }}/status">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <input type="hidden" name="action" value="markOverdue">
                <button class="w-full rounded-md border border-line px-4 py-2 text-sm font-semibold text-ink shadow-sm hover:bg-panel" type="submit">Mark overdue</button>
              </form>
            {% endif %}

            {% if 'markPaid' in allowedActions %}
              <form method="post" action="/invoices/{{ invoice.id }}/status" class="space-y-3 rounded-md border border-line p-3">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <input type="hidden" name="action" value="markPaid">
                <div>
                  <label for="paidAt">Paid date</label>
                  <input id="paidAt" name="paidAt" type="date" value="{{ paidAtDefault }}" required>
                </div>
                <div>
                  <label for="reference">Reference</label>
                  <input id="reference" name="reference" value="">
                </div>
                <button class="w-full rounded-md bg-action px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-action-dark" type="submit">Mark paid</button>
              </form>
            {% endif %}

            {% if 'void' in allowedActions %}
              <form method="post" action="/invoices/{{ invoice.id }}/status">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <input type="hidden" name="action" value="void">
                <button class="w-full rounded-md border border-line px-4 py-2 text-sm font-semibold text-muted shadow-sm hover:bg-panel hover:text-ink" type="submit">Void invoice</button>
              </form>
            {% endif %}
          </div>
        {% else %}
          <p class="mt-3 text-sm text-muted">No further status changes are available.</p>
        {% endif %}
      </div>
    </aside>
  </div>
{% endblock %}
