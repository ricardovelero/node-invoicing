{% extends "layouts/app.njk" %}

{% block content %}
  <div class="mb-8">
    <p class="text-sm font-medium text-muted">Billing</p>
    <h1 class="mt-1 text-3xl font-semibold">New invoice</h1>
  </div>

  {% if customers.length %}
    <form method="post" action="/invoices" x-data="invoiceForm()" class="max-w-3xl space-y-6 rounded-lg border border-line bg-white p-6">
      <div>
        <label for="customerId">Customer</label>
        <select id="customerId" name="customerId">
          <option value="">Choose a customer</option>
          {% for customer in customers %}
            <option value="{{ customer.id }}" {{ 'selected' if values.customerId == customer.id else '' }}>{{ customer.name }}</option>
          {% endfor %}
        </select>
        {% if errors.customerId %}<p class="mt-1 text-sm text-red-700">{{ errors.customerId[0] }}</p>{% endif %}
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="issueDate">Issue date</label>
          <input id="issueDate" name="issueDate" type="date" value="{{ values.issueDate or '' }}">
          {% if errors.issueDate %}<p class="mt-1 text-sm text-red-700">{{ errors.issueDate[0] }}</p>{% endif %}
        </div>
        <div>
          <label for="dueDate">Due date</label>
          <input id="dueDate" name="dueDate" type="date" value="{{ values.dueDate or '' }}">
          {% if errors.dueDate %}<p class="mt-1 text-sm text-red-700">{{ errors.dueDate[0] }}</p>{% endif %}
        </div>
      </div>

      <div class="rounded-md border border-line">
        <div class="grid gap-3 border-b border-line bg-panel px-4 py-3 text-sm font-medium text-muted sm:grid-cols-[1fr_100px_140px_120px]">
          <span>Description</span>
          <span>Quantity</span>
          <span>Unit price</span>
          <span class="text-right">Total</span>
        </div>
        <div class="grid gap-3 p-4 sm:grid-cols-[1fr_100px_140px_120px] sm:items-start">
          <div>
            <input name="lineDescription" value="{{ values.lineDescription or '' }}" placeholder="Consulting services">
            {% if errors.lineDescription %}<p class="mt-1 text-sm text-red-700">{{ errors.lineDescription[0] }}</p>{% endif %}
          </div>
          <div>
            <input name="quantity" type="number" min="0.01" step="0.01" x-model.number="quantity" value="{{ values.quantity or 1 }}">
            {% if errors.quantity %}<p class="mt-1 text-sm text-red-700">{{ errors.quantity[0] }}</p>{% endif %}
          </div>
          <div>
            <input name="unitPrice" type="number" min="0" step="0.01" x-model.number="unitPrice" value="{{ values.unitPrice or 0 }}">
            {% if errors.unitPrice %}<p class="mt-1 text-sm text-red-700">{{ errors.unitPrice[0] }}</p>{% endif %}
          </div>
          <div class="rounded-md bg-panel px-3 py-2 text-right text-sm font-semibold" x-text="total">€0.00</div>
        </div>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <button class="rounded-md bg-action px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-action-dark" type="submit">Create invoice</button>
        <a class="text-sm font-medium text-muted hover:text-ink" href="/invoices">Cancel</a>
      </div>
    </form>
  {% else %}
    <div class="max-w-xl rounded-lg border border-line bg-white p-6">
      <h2 class="text-lg font-semibold">Create a customer first</h2>
      <p class="mt-2 text-sm text-muted">Invoices need to be attached to a customer.</p>
      <a href="/customers/new" class="mt-5 inline-flex items-center justify-center rounded-md bg-action px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-action-dark">New customer</a>
    </div>
  {% endif %}
{% endblock %}
