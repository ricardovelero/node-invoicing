{% extends "pages/settings/_layout.njk" %}

{% from "components/ui/label-field.njk" import labelField %}
{% from "components/ui/input-field.njk" import inputField %}
{% from "components/ui/password-field.njk" import passwordField %}


{% block settingsContent %}
  <div class="mb-6 max-w-3xl">
    <h2 class="text-xl font-semibold">{{ t('settings.sections.security.title') }}</h2>
    <p class="mt-1 text-sm text-muted">{{ t('settings.sections.security.description') }}</p>
  </div>

  <form method="post" action="/settings/security" data-unsaved-changes-guard class="max-w-3xl space-y-6 rounded-lg border border-line bg-white p-6">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <section>
      <h3 class="text-base font-semibold text-ink">{{ t('settings.security.sessionTimeouts') }}</h3>
      <p class="mt-1 text-sm text-muted">{{ t('settings.security.sessionTimeoutsDescription') }}</p>

      <div class="mt-5 grid gap-5 md:grid-cols-2">
        <div>
          {{ labelField('sessionIdleTimeoutMinutes', t('settings.fields.sessionIdleTimeoutMinutes'), required=true) }}
          {{ inputField('sessionIdleTimeoutMinutes', type='number', value=values.sessionIdleTimeoutMinutes, error=errors.sessionIdleTimeoutMinutes, required=true, help=t('settings.help.sessionIdleTimeoutMinutes'), attrs='min="5" max="1440" step="1"') }}
        </div>
        <div>
          {{ labelField('sessionAbsoluteLifetimeDays', t('settings.fields.sessionAbsoluteLifetimeDays'), required=true) }}
          {{ inputField('sessionAbsoluteLifetimeDays', type='number', value=values.sessionAbsoluteLifetimeDays, error=errors.sessionAbsoluteLifetimeDays, required=true, help=t('settings.help.sessionAbsoluteLifetimeDays'), attrs='min="1" max="90" step="1"') }}
        </div>
      </div>
    </section>

    <div class="flex items-center justify-end gap-3 pt-2">
      <a class="btn btn-secondary" href="/settings">{{ t('common.actions.cancel') }}</a>
      <button class="btn btn-primary" type="submit">{{ t('settings.actions.save') }}</button>
    </div>
  </form>

  <form method="post" action="/settings/security/password" class="mt-6 max-w-3xl space-y-6 rounded-lg border border-line bg-white p-6">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <section>
      <h3 class="text-base font-semibold text-ink">{{ t('settings.security.changePassword') }}</h3>
      <p class="mt-1 text-sm text-muted">{{ t('settings.security.changePasswordDescription') }}</p>

      <div class="mt-5 space-y-5">
        <div>
          {{ labelField('currentPassword', t('settings.fields.currentPassword'), required=true) }}
          {{ passwordField('currentPassword', autocomplete='current-password', error=passwordErrors.currentPassword, required=true) }}
        </div>
        <div>
          {{ labelField('newPassword', t('settings.fields.newPassword'), required=true) }}
          {{ passwordField('newPassword', autocomplete='new-password', error=passwordErrors.newPassword, required=true, validate='password') }}
        </div>
        <div>
          {{ labelField('confirmPassword', t('settings.fields.confirmPassword'), required=true) }}
          {{ passwordField('confirmPassword', autocomplete='new-password', error=passwordErrors.confirmPassword, required=true) }}
        </div>
      </div>
    </section>

    <div class="flex items-center justify-end gap-3 pt-2">
      <button class="btn btn-primary" type="submit">{{ t('settings.actions.changePassword') }}</button>
    </div>
  </form>

  <section class="mt-6 max-w-3xl space-y-6 rounded-lg border border-line bg-white p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
      <div>
        <h3 class="text-base font-semibold text-ink">{{ t('settings.security.activeSessions') }}</h3>
        <p class="mt-1 text-sm text-muted">{{ t('settings.security.activeSessionsDescription') }}</p>
      </div>
      <form method="post" action="/settings/security/sessions/revoke-others">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button class="btn btn-secondary" type="submit">{{ t('settings.actions.revokeOtherSessions') }}</button>
      </form>
    </div>

    {% if sessions and sessions.length %}
      <div class="divide-y divide-line rounded-md border border-line">
        {% for session in sessions %}
          <div class="grid gap-4 p-4 md:grid-cols-[1fr_auto] md:items-center">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <p class="font-medium text-ink">{{ session.browserDevice }}</p>
                {% if session.isCurrent %}
                  <span class="rounded-full bg-action/10 px-2 py-0.5 text-xs font-medium text-action">{{ t('settings.security.currentSession') }}</span>
                {% endif %}
              </div>
              <dl class="mt-3 grid gap-2 text-sm text-muted sm:grid-cols-2">
                <div>
                  <dt class="font-medium text-ink">{{ t('settings.security.lastSeen') }}</dt>
                  <dd><time datetime="{{ session.lastSeenAtIso }}">{{ session.lastSeenAtDisplay }}</time></dd>
                </div>
                <div>
                  <dt class="font-medium text-ink">{{ t('settings.security.ipAddress') }}</dt>
                  <dd>{{ session.ip or t('settings.security.unknownIp') }}</dd>
                </div>
                <div>
                  <dt class="font-medium text-ink">{{ t('settings.security.created') }}</dt>
                  <dd><time datetime="{{ session.createdAtIso }}">{{ session.createdAtDisplay }}</time></dd>
                </div>
                <div>
                  <dt class="font-medium text-ink">{{ t('settings.security.expires') }}</dt>
                  <dd><time datetime="{{ session.expiresAtIso }}">{{ session.expiresAtDisplay }}</time></dd>
                </div>
              </dl>
            </div>
            {% if not session.isCurrent %}
              <form method="post" action="/settings/security/sessions/{{ session.id }}/revoke" class="md:justify-self-end">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <button class="btn btn-secondary" type="submit">{{ t('settings.actions.revokeSession') }}</button>
              </form>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="rounded-md border border-dashed border-line p-4 text-sm text-muted">{{ t('settings.security.noActiveSessions') }}</p>
    {% endif %}
  </section>
{% endblock %}
