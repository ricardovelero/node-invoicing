{% from "components/ui/label-field.njk" import labelField %}
{% from "components/ui/input-field.njk" import inputField %}
{% from "components/ui/select-field.njk" import selectField %}
{% from "components/ui/textarea-field.njk" import textareaField %}
{% from "components/ui/checkbox-field.njk" import checkboxField %}

<form method="post" action="{{ formAction }}" data-unsaved-changes-guard class="max-w-3xl space-y-6 rounded-lg border border-line bg-white p-6">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">

  <div>
    {{ labelField('legalName', t('settings.fields.legalName'), required=true) }}
    {{ inputField('legalName', value=values.legalName or '', error=errors.legalName, required=true, autocomplete='organization', validate='required', validateLabel=t('settings.fields.legalName')) }}
  </div>

  <div>
    {{ labelField('billingEmail', t('settings.fields.billingEmail')) }}
    {{ inputField('billingEmail', type='email', value=values.billingEmail or '', error=errors.billingEmail, required=false, autocomplete='email', validate='email', placeholder=t('settings.placeholders.billingEmail'), help=t('settings.help.billingEmail')) }}
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      {{ labelField('taxId', t('settings.fields.taxId')) }}
      {{ inputField('taxId', value=values.taxId or '', error=errors.taxId) }}
    </div>
    <div>
      {{ labelField('currency', t('settings.fields.defaultCurrency'), required=true) }}
      {{ selectField('currency', currencyOptions, value=values.currency, error=errors.currency, required=true) }}
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      {{ labelField('countryCode', t('settings.fields.countryCode'), required=true) }}
      {{ selectField('countryCode', countryOptions, value=values.countryCode, error=errors.countryCode, required=true) }}
    </div>
    <div>
      {{ labelField('city', t('settings.fields.city')) }}
      {{ inputField('city', value=values.city or '', error=errors.city, autocomplete='address-level2') }}
    </div>
  </div>

  <div>
    {{ labelField('addressLine1', t('settings.fields.address')) }}
    {{ inputField('addressLine1', value=values.addressLine1 or '', error=errors.addressLine1, autocomplete='street-address') }}
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      {{ labelField('legalForm', t('settings.fields.legalForm')) }}
      {{ selectField('legalForm', legalFormOptions, value=values.legalForm, error=errors.legalForm, attrs='data-withholding-legal-form') }}
    </div>
  </div>

  <section class="rounded-md border border-line bg-panel p-4"{% if values.countryCode != 'ES' or values.legalForm == 'company' %} hidden{% endif %} data-withholding-settings>
    <div{% if values.legalForm == 'company' %} hidden{% endif %} data-withholding-enable-row>
      <div class="flex items-start gap-3">
        {{ checkboxField('withholdingEnabled', checked=values.withholdingEnabled, error=errors.withholdingEnabled, attrs='data-withholding-enabled') }}
        <div>
          {{ labelField('withholdingEnabled', t('settings.withholding.enableIrpf'), className='font-semibold') }}
          <p class="mt-1 text-sm text-muted">{{ t('settings.withholding.irpfHelp') }}</p>
        </div>
      </div>
    </div>

    <input type="hidden" name="defaultWithholdingType" value="IRPF">

    <div class="mt-4 grid gap-5 sm:grid-cols-[180px_1fr]"{% if not values.withholdingEnabled %} hidden{% endif %} data-withholding-rate-fields>
      <div>
        {{ labelField('defaultWithholdingRateType', t('settings.fields.defaultWithholdingRate')) }}
        {{ selectField('defaultWithholdingRateType', withholdingRateTypeOptions, value=values.defaultWithholdingRateType, attrs='data-withholding-rate-type') }}
      </div>
      <div{% if values.defaultWithholdingRateType != 'custom' or not values.withholdingEnabled %} hidden{% endif %} data-withholding-custom-rate>
        {{ labelField('defaultWithholdingRate', t('settings.fields.customWithholdingRate'), required=values.withholdingEnabled and values.defaultWithholdingRateType == 'custom') }}
        {{ inputField('defaultWithholdingRate', type='number', value=values.defaultWithholdingRate, error=errors.defaultWithholdingRate, required=values.withholdingEnabled and values.defaultWithholdingRateType == 'custom', attrs='min="0.01" max="100" step="0.01" data-withholding-rate-input') }}
        {% if errors.defaultWithholdingType %}<p class="mt-1 text-sm text-red-700">{{ errors.defaultWithholdingType[0] }}</p>{% endif %}
      </div>
    </div>
  </section>

  <div>
    {{ labelField('paymentInstructions', t('settings.fields.paymentInstructions')) }}
    {{ textareaField('paymentInstructions', value=values.paymentInstructions or '', error=errors.paymentInstructions, rows=5, maxlength=2000, placeholder=t('settings.placeholders.paymentInstructions')) }}
  </div>

  <div class="flex items-center justify-end gap-3 pt-2">
    <a class="btn btn-secondary" href="{{ cancelHref }}">{{ t('common.actions.cancel') }}</a>
    <button class="btn btn-primary" type="submit">{{ submitLabel }}</button>
  </div>
</form>
