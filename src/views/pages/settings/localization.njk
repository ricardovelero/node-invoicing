{% extends "pages/settings/_layout.njk" %}
{% from "components/ui/label-field.njk" import labelField %}
{% from "components/ui/select-field.njk" import selectField %}

{% block settingsContent %}
  <div class="mb-6 max-w-3xl">
    <h2 class="text-xl font-semibold">{{ t('settings.sections.localization.title') }}</h2>
    <p class="mt-1 text-sm text-muted">{{ t('settings.sections.localization.description') }}</p>
  </div>

  <form method="post" action="/settings/localization" data-unsaved-changes-guard class="max-w-3xl space-y-6 rounded-lg border border-line bg-white p-6">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <div class="max-w-xs">
      {{ labelField('locale', t('settings.fields.locale'), required=true) }}
      {{ selectField('locale', localeOptions, value=values.locale, error=errors.locale, required=true, help=t('settings.help.locale')) }}
    </div>

    <div class="flex items-center justify-end gap-3 pt-2">
      <a class="btn btn-secondary" href="/settings">{{ t('common.actions.cancel') }}</a>
      <button class="btn btn-primary" type="submit">{{ t('settings.actions.save') }}</button>
    </div>
  </form>
{% endblock %}
