{% extends "pages/settings/_layout.njk" %}
{% from "components/country-select.njk" import countrySelect %}

{% block settingsContent %}
  <div class="mb-6 max-w-3xl">
    <h2 class="text-xl font-semibold">{{ t('settings.sections.organization.title') }}</h2>
    <p class="mt-1 text-sm text-muted">{{ t('settings.sections.organization.description') }}</p>
  </div>

  <form method="post" action="/settings/organization" data-unsaved-changes-guard class="max-w-3xl space-y-6 rounded-lg border border-line bg-white p-6">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <div>
      <label for="legalName">{{ t('settings.fields.legalName') }}</label>
      <input id="legalName" name="legalName" value="{{ values.legalName or '' }}" autocomplete="organization">
      {% if errors.legalName %}<p class="mt-1 text-sm text-red-700">{{ errors.legalName[0] }}</p>{% endif %}
    </div>

    <div>
      <label for="billingEmail">{{ t('settings.fields.billingEmail') }}</label>
      <input id="billingEmail" name="billingEmail" type="email" value="{{ values.billingEmail or '' }}" autocomplete="email" placeholder="{{ t('settings.placeholders.billingEmail') }}">
      {% if errors.billingEmail %}<p class="mt-1 text-sm text-red-700">{{ errors.billingEmail[0] }}</p>{% endif %}
      <p class="mt-1 text-sm text-muted">{{ t('settings.help.billingEmail') }}</p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="taxId">{{ t('settings.fields.taxId') }}</label>
        <input id="taxId" name="taxId" value="{{ values.taxId or '' }}">
        {% if errors.taxId %}<p class="mt-1 text-sm text-red-700">{{ errors.taxId[0] }}</p>{% endif %}
      </div>
      <div>
        <label for="currency">{{ t('settings.fields.defaultCurrency') }} <span aria-hidden="true">*</span></label>
        <select id="currency" name="currency" required>
          {% for currency in ['EUR', 'USD', 'GBP', 'CAD', 'AUD'] %}
            <option value="{{ currency }}" {{ 'selected' if values.currency == currency else '' }}>{{ currency }}</option>
          {% endfor %}
        </select>
        {% if errors.currency %}<p class="mt-1 text-sm text-red-700">{{ errors.currency[0] }}</p>{% endif %}
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="countryCode">{{ t('settings.fields.countryCode') }} <span aria-hidden="true">*</span></label>
        {{ countrySelect('countryCode', 'countryCode', values.countryCode, true) }}
        {% if errors.countryCode %}<p class="mt-1 text-sm text-red-700">{{ errors.countryCode[0] }}</p>{% endif %}
      </div>
      <div>
        <label for="legalForm">{{ t('settings.fields.legalForm') }} <span aria-hidden="true">*</span></label>
        <select id="legalForm" name="legalForm" required>
          <option value="sole_trader" {{ 'selected' if values.legalForm == 'sole_trader' else '' }}>{{ t('settings.legalForms.soleTrader') }}</option>
          <option value="company" {{ 'selected' if values.legalForm == 'company' else '' }}>{{ t('settings.legalForms.company') }}</option>
          <option value="other" {{ 'selected' if values.legalForm == 'other' else '' }}>{{ t('settings.legalForms.other') }}</option>
        </select>
        {% if errors.legalForm %}<p class="mt-1 text-sm text-red-700">{{ errors.legalForm[0] }}</p>{% endif %}
      </div>
    </div>

    <div>
      <label for="addressLine1">{{ t('settings.fields.address') }}</label>
      <input id="addressLine1" name="addressLine1" value="{{ values.addressLine1 or '' }}" autocomplete="street-address">
      {% if errors.addressLine1 %}<p class="mt-1 text-sm text-red-700">{{ errors.addressLine1[0] }}</p>{% endif %}
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="city">{{ t('settings.fields.city') }}</label>
        <input id="city" name="city" value="{{ values.city or '' }}" autocomplete="address-level2">
        {% if errors.city %}<p class="mt-1 text-sm text-red-700">{{ errors.city[0] }}</p>{% endif %}
      </div>
    </div>

    {% if withholdingEligible %}
      <section class="rounded-md border border-line bg-panel p-4">
        <div class="flex items-start gap-3">
          <input id="withholdingEnabled" class="mt-1 h-4 w-4" name="withholdingEnabled" type="checkbox" {{ 'checked' if values.withholdingEnabled else '' }}>
          <div>
            <label class="font-semibold" for="withholdingEnabled">{{ t('settings.withholding.enableIrpf') }}</label>
            <p class="mt-1 text-sm text-muted">{{ t('settings.withholding.irpfHelp') }}</p>
            {% if errors.withholdingEnabled %}<p class="mt-1 text-sm text-red-700">{{ errors.withholdingEnabled[0] }}</p>{% endif %}
          </div>
        </div>
        <input type="hidden" name="defaultWithholdingType" value="IRPF">
        <div class="mt-4 grid gap-5 sm:grid-cols-[180px_1fr]">
          <div>
            <label for="defaultWithholdingRateType">{{ t('settings.fields.defaultWithholdingRate') }}</label>
            <select id="defaultWithholdingRateType" name="defaultWithholdingRateType">
              <option value="15" {{ 'selected' if values.defaultWithholdingRateType == '15' else '' }}>15%</option>
              <option value="7" {{ 'selected' if values.defaultWithholdingRateType == '7' else '' }}>7%</option>
              <option value="custom" {{ 'selected' if values.defaultWithholdingRateType == 'custom' else '' }}>{{ t('settings.withholding.customRate') }}</option>
            </select>
          </div>
          <div>
            <label for="defaultWithholdingRate">{{ t('settings.fields.customWithholdingRate') }}</label>
            <input id="defaultWithholdingRate" name="defaultWithholdingRate" type="number" min="0.01" max="100" step="0.01" value="{{ values.defaultWithholdingRate or '15' }}">
            {% if errors.defaultWithholdingType %}<p class="mt-1 text-sm text-red-700">{{ errors.defaultWithholdingType[0] }}</p>{% endif %}
            {% if errors.defaultWithholdingRate %}<p class="mt-1 text-sm text-red-700">{{ errors.defaultWithholdingRate[0] }}</p>{% endif %}
          </div>
        </div>
      </section>
    {% endif %}

    <div>
      <label for="paymentInstructions">{{ t('settings.fields.paymentInstructions') }}</label>
      <textarea id="paymentInstructions" name="paymentInstructions" rows="5" maxlength="2000" placeholder="{{ t('settings.placeholders.paymentInstructions') }}">{{ values.paymentInstructions or '' }}</textarea>
      {% if errors.paymentInstructions %}<p class="mt-1 text-sm text-red-700">{{ errors.paymentInstructions[0] }}</p>{% endif %}
    </div>

    <div class="flex items-center justify-end gap-3 pt-2">
      <a class="btn btn-secondary" href="/settings">{{ t('common.actions.cancel') }}</a>
      <button class="btn btn-primary" type="submit">{{ t('settings.actions.save') }}</button>
    </div>
  </form>
{% endblock %}
