{% extends "pages/settings/_layout.njk" %}
{% from "components/ui/label-field.njk" import labelField %}
{% from "components/ui/input-field.njk" import inputField %}
{% from "components/ui/select-field.njk" import selectField %}

{% block settingsContent %}
  <div class="mb-6 max-w-3xl">
    <h2 class="text-xl font-semibold">{{ t('settings.sections.profile.title') }}</h2>
    <p class="mt-1 text-sm text-muted">{{ t('settings.sections.profile.description') }}</p>
  </div>

  <form method="post" action="/settings/profile" data-unsaved-changes-guard class="max-w-3xl space-y-6 rounded-lg border border-line bg-white p-6">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <div>
      {{ labelField('fullName', t('settings.fields.fullName'), required=true) }}
      {{ inputField('fullName', value=values.fullName or '', error=errors.fullName, required=true, autocomplete='name', validate='required', validateLabel=t('settings.fields.fullName')) }}
    </div>

    <div>
      {{ labelField('email', t('settings.fields.email')) }}
      {{ inputField('email', type='email', value=values.email or '', error=errors.email, required=false, autocomplete='email', help=t('settings.help.emailReadOnly'), attrs='readonly') }}
    </div>

    <div>
      {{ labelField('timeZone', t('settings.fields.timeZone')) }}
      {{ selectField('timeZone', timeZoneOptions, value=values.timeZone, error=errors.timeZone, help=t('settings.help.timeZone')) }}
    </div>

    <div class="flex items-center justify-end gap-3 pt-2">
      <a class="btn btn-secondary" href="/settings/profile">{{ t('common.actions.cancel') }}</a>
      <button class="btn btn-primary" type="submit">{{ t('settings.actions.saveChanges') }}</button>
    </div>
  </form>
{% endblock %}
