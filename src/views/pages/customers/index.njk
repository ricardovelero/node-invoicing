{% extends "layouts/app.njk" %}

{% block content %}
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-medium text-muted">Directory</p>
      <h1 class="mt-1 text-3xl font-semibold">Customers</h1>
    </div>
    <a href="/customers/new" class="inline-flex items-center justify-center rounded-md bg-action px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-action-dark">New customer</a>
  </div>

  <div class="overflow-hidden rounded-lg border border-line bg-white">
    <table class="min-w-full divide-y divide-line text-sm">
      <thead class="bg-panel text-left text-muted">
        <tr>
          <th class="px-4 py-3 font-medium">Name</th>
          <th class="px-4 py-3 font-medium">Email</th>
          <th class="px-4 py-3 font-medium">Location</th>
          <th class="px-4 py-3 font-medium">Created</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        {% for customer in customers %}
          <tr>
            <td class="px-4 py-3 font-medium">{{ customer.name }}</td>
            <td class="px-4 py-3 text-muted">{{ customer.email or '—' }}</td>
            <td class="px-4 py-3 text-muted">{{ customer.city or '' }}{% if customer.city and customer.country %}, {% endif %}{{ customer.country or '' }}</td>
            <td class="px-4 py-3 text-muted">{{ customer.createdAt | date }}</td>
          </tr>
        {% else %}
          <tr>
            <td class="px-4 py-6 text-muted" colspan="4">No customers yet.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}
