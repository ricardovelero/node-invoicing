{% extends "layouts/app.njk" %}
{% from "components/ui/badge.njk" import badge %}
{% from "components/confirm-dialog.njk" import confirmDialog %}

{% block content %}
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-muted">{{ t('customers.detail.section') }}</p>
      <h1 class="mt-1 text-3xl font-semibold">{{ customer.name }}</h1>
      <p class="mt-2 text-sm text-muted">{{ customer.email or t('customers.detail.noEmail') }}</p>
      {% if customer.archivedAt %}
        <p class="mt-3 btn btn-link">{{ t('customers.detail.archived') }}</p>
      {% endif %}
    </div>
    <a class="btn btn-link" href="/customers">{{ t('customers.actions.backToCustomers') }}</a>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1fr_320px]">
    <section class="space-y-6">
      <div class="rounded-lg border border-line bg-white p-6">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-lg font-semibold">{{ t('customers.detail.invoices') }}</h2>
          <a class="btn btn-primary" href="/invoices/new?customerId={{ customer.id }}">{{ t('customers.actions.newInvoice') }}</a>
        </div>
        <div class="overflow-hidden rounded-md border border-line">
          <table class="min-w-full divide-y divide-line text-sm">
            <thead class="bg-panel text-left text-muted">
              <tr>
                <th class="px-4 py-3 font-medium">{{ t('customers.table.number') }}</th>
                <th class="px-4 py-3 font-medium">{{ t('customers.table.due') }}</th>
                <th class="px-4 py-3 font-medium">{{ t('customers.table.status') }}</th>
                <th class="px-4 py-3 text-right font-medium">{{ t('customers.table.total') }}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {% for invoice in invoiceRows %}
                <tr>
                  <td class="px-4 py-3 font-medium">
                    <a class="text-action hover:text-action-dark" href="/invoices/{{ invoice.id }}">{{ invoice.number }}</a>
                  </td>
                  <td class="px-4 py-3 text-muted">{{ invoice.dueDate | date(currentLocale) }}</td>
                  <td class="px-4 py-3">
                    <div class="flex flex-wrap gap-2">
                      {% for statusBadge in invoice.statusBadges %}
                        {{ badge(t(statusBadge.labelKey) if statusBadge.labelKey else statusBadge.label, statusBadge.variant) }}
                      {% endfor %}
                    </div>
                  </td>
                  <td class="px-4 py-3 text-right">{{ invoice.totalCents | money(invoice.currency, currentLocale) }}</td>
                </tr>
              {% else %}
                <tr>
                  <td class="px-4 py-6 text-muted" colspan="4">{{ t('customers.detail.noInvoices') }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>

      <div class="rounded-lg border border-line bg-white p-6">
        <h2 class="text-lg font-semibold">{{ t('customers.detail.payments') }}</h2>
        <div class="mt-4 overflow-hidden rounded-md border border-line">
          <table class="min-w-full divide-y divide-line text-sm">
            <thead class="bg-panel text-left text-muted">
              <tr>
                <th class="px-4 py-3 font-medium">{{ t('customers.table.paid') }}</th>
                <th class="px-4 py-3 font-medium">{{ t('customers.table.invoice') }}</th>
                <th class="px-4 py-3 font-medium">{{ t('customers.table.reference') }}</th>
                <th class="px-4 py-3 text-right font-medium">{{ t('customers.table.amount') }}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {% for payment in payments %}
                <tr>
                  <td class="px-4 py-3">{{ payment.paidAt | date(currentLocale) }}</td>
                  <td class="px-4 py-3">
                    <a class="font-medium text-action hover:text-action-dark" href="/invoices/{{ payment.invoice.id }}">{{ payment.invoice.number }}</a>
                  </td>
                  <td class="px-4 py-3 text-muted">{{ payment.reference or '—' }}</td>
                  <td class="px-4 py-3 text-right">{{ payment.amountCents | money(payment.invoice.currency, currentLocale) }}</td>
                </tr>
              {% else %}
                <tr>
                  <td class="px-4 py-6 text-muted" colspan="4">{{ t('customers.detail.noPayments') }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <aside class="space-y-6">
      <div class="rounded-lg border border-line bg-white p-6">
        <div class="flex items-center justify-between gap-4">
          <h2 class="text-lg font-semibold">{{ t('customers.detail.profile') }}</h2>
          <a class="btn btn-icon" href="/customers/{{ customer.id }}/edit" aria-label="{{ t('customers.actions.edit') }}">
            <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
            </svg>
          </a>
        </div>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="text-muted">{{ t('customers.detail.taxId') }}</dt>
            <dd class="mt-1 font-medium">{{ customer.taxId or '—' }}</dd>
          </div>
          <div>
            <dt class="text-muted">{{ t('customers.detail.address') }}</dt>
            <dd class="mt-1 font-medium">
              {% if customer.addressLine1 or customer.city or customer.country %}
                {{ customer.addressLine1 or '' }}
                {% if customer.addressLine1 and (customer.city or customer.country) %}<br>{% endif %}
                {{ customer.city or '' }}{% if customer.city and customer.country %}, {% endif %}{{ customer.country or '' }}
              {% else %}
                —
              {% endif %}
            </dd>
          </div>
          <div>
            <dt class="text-muted">{{ t('customers.detail.created') }}</dt>
            <dd class="mt-1 font-medium">{{ customer.createdAt | date(currentLocale) }}</dd>
          </div>
          {% if customer.archivedAt %}
            <div>
              <dt class="text-muted">{{ t('customers.detail.archived') }}</dt>
              <dd class="mt-1 font-medium">{{ customer.archivedAt | date(currentLocale) }}</dd>
            </div>
          {% endif %}
        </dl>
      </div>

      <div class="rounded-lg border border-line bg-white p-6">
        <h2 class="text-lg font-semibold">{{ t('customers.detail.totals') }}</h2>
        <div class="mt-4 space-y-3 text-sm">
          <div class="flex justify-between gap-4">
            <span class="text-muted">{{ t('customers.detail.invoices') }}</span>
            <span class="font-medium">{{ customer.invoices.length }}</span>
          </div>
          <div class="flex justify-between gap-4">
            <span class="text-muted">{{ t('customers.detail.payments') }}</span>
            <span class="font-medium">{{ payments.length }}</span>
          </div>
        </div>
      </div>

      <div class="rounded-lg border border-line bg-white p-6">
        <h2 class="text-lg font-semibold">{{ t('customers.detail.actions') }}</h2>
        <div class="mt-4 space-y-3">
          <a class="btn btn-full btn-primary" href="/customers/{{ customer.id }}/edit">{{ t('customers.actions.edit') }}</a>

          {% if customer.archivedAt %}
            <form method="post" action="/customers/{{ customer.id }}/restore">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <button class="btn btn-full btn-secondary" type="submit">{{ t('customers.actions.restore') }}</button>
            </form>
          {% endif %}

          {% if customer.invoices.length == 0 %}
            <button class="btn btn-full btn-danger" type="button" data-dialog-open="delete-customer-dialog">{{ t('customers.actions.delete') }}</button>
            {{ confirmDialog(
              'delete-customer-dialog',
              t('customers.dialogs.delete.title'),
              t('customers.dialogs.delete.description', { name: customer.name }),
              t('customers.actions.delete'),
              t('common.actions.cancel'),
              '/customers/' ~ customer.id ~ '/delete',
              'post',
              csrfToken,
              true
            ) }}
          {% elif not customer.archivedAt %}
            <form method="post" action="/customers/{{ customer.id }}/archive">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <button class="btn btn-full btn-secondary" type="submit">{{ t('customers.actions.archive') }}</button>
            </form>
          {% endif %}
        </div>
      </div>
    </aside>
  </div>
{% endblock %}
