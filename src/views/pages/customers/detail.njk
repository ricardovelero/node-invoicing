{% extends "layouts/app.njk" %}
{% from "components/badge.njk" import badge %}

{% block content %}
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-muted">Customer</p>
      <h1 class="mt-1 text-3xl font-semibold">{{ customer.name }}</h1>
      <p class="mt-2 text-sm text-muted">{{ customer.email or 'No email on file' }}</p>
      {% if customer.archivedAt %}
        <p class="mt-3 inline-flex rounded-full bg-panel px-3 py-1 text-xs font-semibold text-muted">Archived</p>
      {% endif %}
    </div>
    <a class="text-sm font-medium text-muted hover:text-ink" href="/customers">Back to customers</a>
  </div>

  <div class="grid gap-6 lg:grid-cols-[320px_1fr]">
    <aside class="space-y-6">
      <div class="rounded-lg border border-line bg-white p-6">
        <div class="flex items-center justify-between gap-4">
          <h2 class="text-lg font-semibold">Profile</h2>
          <a class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-line text-muted hover:bg-panel hover:text-ink" href="/customers/{{ customer.id }}/edit" aria-label="Edit customer">
            <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
            </svg>
          </a>
        </div>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="text-muted">Tax ID</dt>
            <dd class="mt-1 font-medium">{{ customer.taxId or '—' }}</dd>
          </div>
          <div>
            <dt class="text-muted">Address</dt>
            <dd class="mt-1 font-medium">
              {% if customer.addressLine1 or customer.city or customer.country %}
                {{ customer.addressLine1 or '' }}
                {% if customer.addressLine1 and (customer.city or customer.country) %}<br>{% endif %}
                {{ customer.city or '' }}{% if customer.city and customer.country %}, {% endif %}{{ customer.country or '' }}
              {% else %}
                —
              {% endif %}
            </dd>
          </div>
          <div>
            <dt class="text-muted">Created</dt>
            <dd class="mt-1 font-medium">{{ customer.createdAt | date }}</dd>
          </div>
          {% if customer.archivedAt %}
            <div>
              <dt class="text-muted">Archived</dt>
              <dd class="mt-1 font-medium">{{ customer.archivedAt | date }}</dd>
            </div>
          {% endif %}
        </dl>
      </div>

      <div class="rounded-lg border border-line bg-white p-6">
        <h2 class="text-lg font-semibold">Totals</h2>
        <div class="mt-4 space-y-3 text-sm">
          <div class="flex justify-between gap-4">
            <span class="text-muted">Invoices</span>
            <span class="font-medium">{{ customer.invoices.length }}</span>
          </div>
          <div class="flex justify-between gap-4">
            <span class="text-muted">Payments</span>
            <span class="font-medium">{{ payments.length }}</span>
          </div>
        </div>
      </div>

      <div class="rounded-lg border border-line bg-white p-6">
        <h2 class="text-lg font-semibold">Actions</h2>
        <div class="mt-4 space-y-3">
          <a class="flex w-full items-center justify-center rounded-md bg-action px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-action-dark" href="/customers/{{ customer.id }}/edit">Edit customer</a>

          {% if customer.archivedAt %}
            <form method="post" action="/customers/{{ customer.id }}/restore">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <button class="w-full rounded-md border border-line px-4 py-2 text-sm font-semibold text-ink hover:bg-panel" type="submit">Restore customer</button>
            </form>
          {% endif %}

          {% if customer.invoices.length == 0 %}
            <form method="post" action="/customers/{{ customer.id }}/delete">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <button class="w-full rounded-md border border-red-200 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50" type="submit">Delete customer</button>
            </form>
          {% elif not customer.archivedAt %}
            <form method="post" action="/customers/{{ customer.id }}/archive">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <button class="w-full rounded-md border border-line px-4 py-2 text-sm font-semibold text-ink hover:bg-panel" type="submit">Archive customer</button>
            </form>
          {% endif %}
        </div>
      </div>
    </aside>

    <section class="space-y-6">
      <div class="rounded-lg border border-line bg-white p-6">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-lg font-semibold">Invoices</h2>
          <a class="text-sm font-medium text-action hover:text-action-dark" href="/invoices/new">New invoice</a>
        </div>
        <div class="overflow-hidden rounded-md border border-line">
          <table class="min-w-full divide-y divide-line text-sm">
            <thead class="bg-panel text-left text-muted">
              <tr>
                <th class="px-4 py-3 font-medium">Number</th>
                <th class="px-4 py-3 font-medium">Due</th>
                <th class="px-4 py-3 font-medium">Status</th>
                <th class="px-4 py-3 text-right font-medium">Total</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {% for invoice in invoiceRows %}
                <tr>
                  <td class="px-4 py-3 font-medium">
                    <a class="text-action hover:text-action-dark" href="/invoices/{{ invoice.id }}">{{ invoice.number }}</a>
                  </td>
                  <td class="px-4 py-3 text-muted">{{ invoice.dueDate | date }}</td>
                  <td class="px-4 py-3">{{ badge(invoice.statusBadge.label, invoice.statusBadge.variant) }}</td>
                  <td class="px-4 py-3 text-right">{{ invoice.totalCents | money(invoice.currency, currentOrganization.locale) }}</td>
                </tr>
              {% else %}
                <tr>
                  <td class="px-4 py-6 text-muted" colspan="4">No invoices for this customer yet.</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>

      <div class="rounded-lg border border-line bg-white p-6">
        <h2 class="text-lg font-semibold">Payments</h2>
        <div class="mt-4 overflow-hidden rounded-md border border-line">
          <table class="min-w-full divide-y divide-line text-sm">
            <thead class="bg-panel text-left text-muted">
              <tr>
                <th class="px-4 py-3 font-medium">Paid</th>
                <th class="px-4 py-3 font-medium">Invoice</th>
                <th class="px-4 py-3 font-medium">Reference</th>
                <th class="px-4 py-3 text-right font-medium">Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {% for payment in payments %}
                <tr>
                  <td class="px-4 py-3">{{ payment.paidAt | date }}</td>
                  <td class="px-4 py-3">
                    <a class="font-medium text-action hover:text-action-dark" href="/invoices/{{ payment.invoice.id }}">{{ payment.invoice.number }}</a>
                  </td>
                  <td class="px-4 py-3 text-muted">{{ payment.reference or '—' }}</td>
                  <td class="px-4 py-3 text-right">{{ payment.amountCents | money(payment.invoice.currency, currentOrganization.locale) }}</td>
                </tr>
              {% else %}
                <tr>
                  <td class="px-4 py-6 text-muted" colspan="4">No payments recorded for this customer.</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
{% endblock %}
