{% extends "layouts/app.njk" %}
{% from "components/ui/label-field.njk" import labelField %}
{% from "components/ui/input-field.njk" import inputField %}

{% block content %}
  <div class="mb-8">
    <p class="text-sm font-medium text-muted">{{ t('customers.section') }}</p>
    <h1 class="mt-1 text-3xl font-semibold">{{ heading or t('customers.form.newTitle') }}</h1>
  </div>

  <form method="post" action="{{ formAction or '/customers' }}" data-unsaved-changes-guard class="max-w-2xl space-y-5 rounded-lg border border-line bg-white p-6">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div>
      {{ labelField('name', t('customers.form.fields.name'), required=true) }}
      {{ inputField('name', value=values.name or '', error=errors.name, required=true, autocomplete='organization', describedBy=false, renderHiddenError=false, errorId=false) }}
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        {{ labelField('email', t('customers.form.fields.email')) }}
        {{ inputField('email', type='email', value=values.email or '', error=errors.email, autocomplete='email', describedBy=false, renderHiddenError=false, errorId=false) }}
      </div>
      <div>
        {{ labelField('taxId', t('customers.form.fields.taxId')) }}
        {{ inputField('taxId', value=values.taxId or '', describedBy=false, renderHiddenError=false, errorId=false) }}
      </div>
    </div>
    <div>
      {{ labelField('addressLine1', t('customers.form.fields.address')) }}
      {{ inputField('addressLine1', value=values.addressLine1 or '', autocomplete='street-address', describedBy=false, renderHiddenError=false, errorId=false) }}
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        {{ labelField('city', t('customers.form.fields.city')) }}
        {{ inputField('city', value=values.city or '', autocomplete='address-level2', describedBy=false, renderHiddenError=false, errorId=false) }}
      </div>
      <div>
        {{ labelField('country', t('customers.form.fields.country')) }}
        {{ inputField('country', value=values.country or '', autocomplete='country-name', describedBy=false, renderHiddenError=false, errorId=false) }}
      </div>
    </div>
    <div class="flex items-center justify-end gap-3 pt-2">
      <a class="btn btn-secondary" href="{{ cancelHref or '/customers' }}">{{ t('common.actions.cancel') }}</a>
      <button class="btn btn-primary">{{ submitLabel or t('customers.actions.create') }}</button>
    </div>
  </form>
{% endblock %}
