{% extends "layouts/app.njk" %}

{% block content %}
  <div class="mb-8">
    <p class="text-sm font-medium text-muted">{{ t('customers.section') }}</p>
    <h1 class="mt-1 text-3xl font-semibold">{{ heading or t('customers.form.newTitle') }}</h1>
  </div>

  <form method="post" action="{{ formAction or '/customers' }}" data-unsaved-changes-guard class="max-w-2xl space-y-5 rounded-lg border border-line bg-white p-6">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div>
      <label for="name">{{ t('customers.form.fields.name') }}</label>
      <input id="name" name="name" value="{{ values.name or '' }}" autocomplete="organization">
      {% if errors.name %}<p class="mt-1 text-sm text-red-700">{{ errors.name[0] }}</p>{% endif %}
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="email">{{ t('customers.form.fields.email') }}</label>
        <input id="email" name="email" type="email" value="{{ values.email or '' }}" autocomplete="email">
        {% if errors.email %}<p class="mt-1 text-sm text-red-700">{{ errors.email[0] }}</p>{% endif %}
      </div>
      <div>
        <label for="taxId">{{ t('customers.form.fields.taxId') }}</label>
        <input id="taxId" name="taxId" value="{{ values.taxId or '' }}">
      </div>
    </div>
    <div>
      <label for="addressLine1">{{ t('customers.form.fields.address') }}</label>
      <input id="addressLine1" name="addressLine1" value="{{ values.addressLine1 or '' }}" autocomplete="street-address">
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="city">{{ t('customers.form.fields.city') }}</label>
        <input id="city" name="city" value="{{ values.city or '' }}" autocomplete="address-level2">
      </div>
      <div>
        <label for="country">{{ t('customers.form.fields.country') }}</label>
        <input id="country" name="country" value="{{ values.country or '' }}" autocomplete="country-name">
      </div>
    </div>
    <div class="flex items-center justify-end gap-3 pt-2">
      <a class="btn btn-secondary" href="{{ cancelHref or '/customers' }}">{{ t('common.actions.cancel') }}</a>
      <button class="btn btn-primary">{{ submitLabel or t('customers.actions.create') }}</button>
    </div>
  </form>
{% endblock %}
