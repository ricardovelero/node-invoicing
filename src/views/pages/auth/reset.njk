{% extends "layouts/auth-layout.njk" %}
{% from "components/ui/label-field.njk" import labelField %}
{% from "components/ui/password-field.njk" import passwordField %}

{% block content %}
  <div class="mx-auto max-w-md">
    <div class="mb-8">
      <img class="h-9 w-auto" src="/assets/asienta-logo-horizontal.webp" alt="{{ t('common.app.name') }}">
      <h1 class="mt-4 text-2xl/8 font-semibold text-ink">{{ t('auth.reset.heading') }}</h1>
    </div>

    <div class="space-y-5 rounded-lg border border-line bg-white p-6">
      {% if invalidToken %}
        <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800">
          {{ t('auth.reset.invalidToken') }}
        </div>

        <a class="btn btn-full btn-primary" href="/auth/forgot">{{ t('auth.reset.requestNewLink') }}</a>
      {% else %}
        <form method="post" action="/auth/reset/{{ token }}" data-validate-form class="space-y-5">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">

          <div>
            {{ labelField('password', t('auth.fields.newPassword'), required=true) }}
            {{ passwordField('password', autocomplete='new-password', error=errors.password, required=true, validate='password') }}
          </div>

          <button class="btn btn-full btn-primary" type="submit">{{ t('auth.reset.submit') }}</button>
        </form>
      {% endif %}

      <p class="text-center text-sm text-muted">
        <a class="font-medium text-action hover:text-action-dark" href="/auth/login">{{ t('auth.reset.backToLogin') }}</a>
      </p>
    </div>
  </div>
{% endblock %}
