{% extends "layouts/app.njk" %}

{% block content %}
  <div class="mx-auto max-w-md">
    <div class="mb-8">
      <p class="text-sm font-medium text-muted">Account access</p>
      <h1 class="mt-1 text-3xl font-semibold text-ink">Reset password</h1>
    </div>

    <div class="space-y-5 rounded-lg border border-line bg-white p-6">
      {% if invalidToken %}
        <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800">
          This password reset link is invalid or has expired.
        </div>

        <a class="btn btn-full btn-primary" href="/auth/forgot">Request a new link</a>
      {% else %}
        <form method="post" action="/auth/reset/{{ token }}" class="space-y-5">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">

          <div>
            <label class="block text-sm font-medium text-ink" for="password">New password <span class="text-red-600">*</span></label>
            <div class="relative mt-2">
              <input id="password" name="password" type="password" autocomplete="new-password" required pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}" title="Use at least 8 characters with uppercase, lowercase and a number." aria-describedby="password-error" data-password-input class="w-full rounded-md border {{ 'border-red-500' if errors.password else 'border-line' }} px-3 py-2 pr-11 text-sm outline-none focus:border-action">
              <button class="absolute inset-y-0 right-0 inline-flex w-11 items-center justify-center text-muted hover:text-ink" type="button" aria-label="Show password" data-password-toggle>
                <svg data-eye-open class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg data-eye-closed class="hidden h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 3l18 18"></path>
                  <path d="M10.6 10.6A3 3 0 0 0 12 15a3 3 0 0 0 2.4-1.2"></path>
                  <path d="M9.9 5.2A9.9 9.9 0 0 1 12 5c6 0 9.5 7 9.5 7a16.4 16.4 0 0 1-2.3 3.2"></path>
                  <path d="M6.6 6.6C3.9 8.4 2.5 12 2.5 12s3.5 7 9.5 7a9.7 9.7 0 0 0 4.4-1"></path>
                </svg>
              </button>
            </div>
            <p id="password-error" class="mt-1 {{ 'hidden' if not errors.password }} text-sm text-red-700">{{ errors.password[0] if errors.password }}</p>
          </div>

          <button class="btn btn-full btn-primary" type="submit">Reset password</button>
        </form>
      {% endif %}

      <p class="text-center text-sm text-muted">
        <a class="font-medium text-action hover:text-action-dark" href="/auth/login">Back to login</a>
      </p>
    </div>
  </div>
{% endblock %}
