{% extends "layouts/app.njk" %}

{% block content %}
  <div class="mx-auto max-w-md">
    <div class="mb-8">
      <p class="text-sm font-medium text-muted">Account setup</p>
      <h1 class="mt-1 text-3xl font-semibold text-ink">Create account</h1>
    </div>

    <form method="post" action="/auth/register" data-register-form novalidate class="space-y-5 rounded-lg border border-line bg-white p-6">
      <div>
        <label class="block text-sm font-medium text-ink" for="name">Name</label>
        <input id="name" name="name" value="{{ values.name or '' }}" autocomplete="name" class="mt-2 w-full rounded-md border border-line px-3 py-2 text-sm outline-none focus:border-action">
      </div>

      <div>
        <label class="block text-sm font-medium text-ink" for="email">Email <span class="text-red-600">*</span></label>
        <input id="email" name="email" type="email" value="{{ values.email or '' }}" autocomplete="email" required aria-describedby="email-error" data-register-email class="mt-2 w-full rounded-md border border-line px-3 py-2 text-sm outline-none focus:border-action">
        <p id="email-error" data-register-email-error class="mt-1 hidden text-sm text-red-700"></p>
      </div>

      <div>
        <label class="block text-sm font-medium text-ink" for="password">Password <span class="text-red-600">*</span></label>
        <div class="relative mt-2">
          <input id="password" name="password" type="password" autocomplete="new-password" required data-password-input class="w-full rounded-md border border-line px-3 py-2 pr-11 text-sm outline-none focus:border-action">
          <button class="absolute inset-y-0 right-0 inline-flex w-11 items-center justify-center text-muted hover:text-ink" type="button" aria-label="Show password" data-password-toggle>
            <svg data-eye-open class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <svg data-eye-closed class="hidden h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 3l18 18"></path>
              <path d="M10.6 10.6A3 3 0 0 0 12 15a3 3 0 0 0 2.4-1.2"></path>
              <path d="M9.9 5.2A9.9 9.9 0 0 1 12 5c6 0 9.5 7 9.5 7a16.4 16.4 0 0 1-2.3 3.2"></path>
              <path d="M6.6 6.6C3.9 8.4 2.5 12 2.5 12s3.5 7 9.5 7a9.7 9.7 0 0 0 4.4-1"></path>
            </svg>
          </button>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-ink" for="organizationName">Organization</label>
        <input id="organizationName" name="organizationName" value="{{ values.organizationName or '' }}" autocomplete="organization" required class="mt-2 w-full rounded-md border border-line px-3 py-2 text-sm outline-none focus:border-action">
      </div>

      <button class="inline-flex w-full items-center justify-center rounded-md bg-action px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-action-dark" type="submit">Create account</button>
      <p class="text-center text-sm text-muted">
        Already have an account?
        <a class="font-medium text-action hover:text-action-dark" href="/auth/login">Login here</a>
      </p>
    </form>
  </div>
{% endblock %}
