{% extends "layouts/auth-layout.njk" %}
{% from "components/ui/label-field.njk" import labelField %}
{% from "components/ui/input-field.njk" import inputField %}

{% block content %}
  <div class="mx-auto max-w-md">
    <div class="mb-8">
      <img class="h-9 w-auto" src="/assets/asienta-logo-horizontal.webp" alt="{{ t('common.app.name') }}">
      <h1 class="mt-4 text-2xl/8 font-semibold text-ink">{{ t('auth.forgot.heading') }}</h1>
    </div>

    <form method="post" action="/auth/forgot" data-validate-form class="space-y-5 rounded-lg border border-line bg-white p-6">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">

      {% if success %}
        <div class="rounded-md border border-green-200 bg-green-50 p-4 text-sm text-green-800">
          {{ t('auth.forgot.success') }}
        </div>
      {% endif %}

      <div>
        {{ labelField('email', t('auth.fields.email'), required=true) }}
        {{ inputField('email', type='email', value=values.email, error=errors.email, required=true, autocomplete='email', validate='email') }}
      </div>

      <button class="btn btn-full btn-primary" type="submit">{{ t('auth.forgot.submit') }}</button>

      <p class="text-center text-sm text-muted">
        {{ t('auth.forgot.switchPrompt') }}
        <a class="font-medium text-action hover:text-action-dark" href="/auth/login">{{ t('auth.forgot.backToLogin') }}</a>
      </p>
    </form>
  </div>
{% endblock %}
