{% extends "layouts/app.njk" %}

{% block content %}
  <div class="mx-auto max-w-md">
    <div class="mb-8">
      <p class="text-sm font-medium text-muted">Welcome back</p>
      <h1 class="mt-1 text-3xl font-semibold text-ink">Log in</h1>
    </div>

    <form method="post" action="/auth/login" class="space-y-5 rounded-lg border border-line bg-white p-6">
      <div>
        <label class="block text-sm font-medium text-ink" for="email">Email</label>
        <input id="email" name="email" type="email" value="{{ values.email or '' }}" autocomplete="email" required class="mt-2 w-full rounded-md border border-line px-3 py-2 text-sm outline-none focus:border-action">
      </div>

      <div>
        <label class="block text-sm font-medium text-ink" for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required class="mt-2 w-full rounded-md border border-line px-3 py-2 text-sm outline-none focus:border-action">
      </div>

      <button class="inline-flex w-full items-center justify-center rounded-md bg-action px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-action-dark" type="submit">Log in</button>
    </form>
  </div>
{% endblock %}
