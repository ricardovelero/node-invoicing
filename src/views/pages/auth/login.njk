{% extends "layouts/app.njk" %}
{% from "components/form-field.njk" import field, passwordField %}

{% block content %}
  <div class="mx-auto max-w-md">
    <div class="mb-8">
      <p class="text-sm font-medium text-muted">Welcome back</p>
      <h1 class="mt-1 text-3xl font-semibold text-ink">Log in</h1>
    </div>

    <form method="post" action="/auth/login" data-validate-form class="space-y-5 rounded-lg border border-line bg-white p-6">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      {{ field('email', 'Email', type='email', value=values.email, error=errors.email, required=true, autocomplete='email', validate='email') }}
      {{ passwordField('password', 'Password', autocomplete='current-password', error=errors.password, validate='password') }}

      <button class="btn btn-full btn-primary" type="submit">Log in</button>
      <p class="text-center text-sm text-muted">
        Don't have an account?
        <a class="font-medium text-action hover:text-action-dark" href="/auth/register">Register here</a>
      </p>
    </form>
  </div>
{% endblock %}
