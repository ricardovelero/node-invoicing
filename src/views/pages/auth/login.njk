{% extends "layouts/auth-layout.njk" %}
{% from "components/ui/label-field.njk" import labelField %}
{% from "components/ui/input-field.njk" import inputField %}
{% from "components/ui/password-field.njk" import passwordField %}

{% block content %}
  <div class="mx-auto max-w-md">
    <div class="mb-8">
      <img class="h-9 w-auto" src="/assets/asienta-logo-horizontal.webp" alt="{{ t('common.app.name') }}">
      <h1 class="mt-4 text-2xl/8 font-semibold text-ink">{{ t('auth.login.heading') }}</h1>
    </div>

    <form method="post" action="/auth/login" data-validate-form class="space-y-5 rounded-lg border border-line bg-white p-6">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div>
        {{ labelField('email', t('auth.fields.email'), required=true) }}
        {{ inputField('email', type='email', value=values.email, error=errors.email, required=true, autocomplete='email', validate='email') }}
      </div>
      <div>
        {{ labelField('password', t('auth.fields.password'), required=true) }}
        {{ passwordField('password', autocomplete='current-password', error=errors.password, required=true, validate='password') }}
      </div>

      <p class="text-right text-sm -mt-4">
        <a class="font-medium text-action hover:text-action-dark" href="/auth/forgot">{{ t('auth.login.forgotPassword') }}</a>
      </p>

      <button class="btn btn-full btn-primary mt-4" type="submit">{{ t('auth.login.submit') }}</button>
      <p class="text-center text-sm text-muted -mt-3">
        {{ t('auth.login.switchPrompt') }}
        <a class="font-medium text-action hover:text-action-dark" href="/auth/register">{{ t('auth.login.registerLink') }}</a>
      </p>
    </form>
  </div>
{% endblock %}
