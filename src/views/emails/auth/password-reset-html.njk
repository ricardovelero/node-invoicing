<!doctype html>
<html lang="en">
  <body style="font-family: Arial, sans-serif; color: #111827; line-height: 1.5;">
    <p>Hello{% if user.name %} {{ user.name }}{% endif %},</p>
    <p>Use the button below to reset your Invoicing password. This link expires in 1 hour.</p>
    <p>
      <a href="{{ resetUrl }}" style="display: inline-block; border-radius: 6px; background: #2563eb; color: #ffffff; padding: 10px 16px; text-decoration: none;">Reset password</a>
    </p>
    <p>If you did not request a password reset, you can ignore this email.</p>
    <p style="font-size: 13px; color: #6b7280;">If the button does not work, paste this link into your browser: {{ resetUrl }}</p>
  </body>
</html>
