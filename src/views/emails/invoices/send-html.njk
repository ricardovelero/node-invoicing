<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Invoice {{ invoice.number }}</title>
  </head>
  <body style="margin:0;background:#f6f7f9;color:#172033;font-family:Arial,sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f6f7f9;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:640px;background:#ffffff;border:1px solid #dfe3ea;border-radius:8px;overflow:hidden;">
            <tr>
              <td style="padding:28px 32px;border-bottom:1px solid #dfe3ea;">
                <p style="margin:0 0 8px;color:#687083;font-size:14px;">Invoice from {{ sellerName }}</p>
                <h1 style="margin:0;color:#172033;font-size:28px;line-height:1.2;">{{ invoice.number }}</h1>
              </td>
            </tr>
            <tr>
              <td style="padding:28px 32px;">
                <p style="margin:0 0 18px;font-size:16px;line-height:1.5;">Hello {{ invoiceDisplay.snapshot.customerName }},</p>
                <p style="margin:0 0 24px;font-size:16px;line-height:1.5;">Your invoice is ready to view online.</p>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom:24px;border-collapse:collapse;font-size:14px;">
                  <tr>
                    <td style="padding:10px 0;color:#687083;">Issue date</td>
                    <td align="right" style="padding:10px 0;font-weight:600;">{{ invoice.issueDate | date }}</td>
                  </tr>
                  <tr>
                    <td style="padding:10px 0;color:#687083;border-top:1px solid #edf0f4;">Due date</td>
                    <td align="right" style="padding:10px 0;border-top:1px solid #edf0f4;font-weight:600;">{{ invoice.dueDate | date }}</td>
                  </tr>
                  <tr>
                    <td style="padding:10px 0;color:#687083;border-top:1px solid #edf0f4;">Total</td>
                    <td align="right" style="padding:10px 0;border-top:1px solid #edf0f4;font-weight:600;">{{ invoice.totalCents | money(invoiceDisplay.currency, currentOrganization.locale) }}</td>
                  </tr>
                  <tr>
                    <td style="padding:10px 0;color:#687083;border-top:1px solid #edf0f4;">Outstanding</td>
                    <td align="right" style="padding:10px 0;border-top:1px solid #edf0f4;font-weight:600;">{{ paymentSummary.outstandingCents | money(invoiceDisplay.currency, currentOrganization.locale) }}</td>
                  </tr>
                </table>

                <p style="margin:0 0 28px;">
                  <a href="{{ publicInvoiceUrl }}" style="display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;border-radius:6px;padding:12px 18px;font-size:14px;font-weight:700;">View invoice</a>
                </p>

                {% if invoiceDisplay.snapshot.paymentInstructions %}
                  <div style="border-top:1px solid #dfe3ea;padding-top:20px;">
                    <p style="margin:0 0 8px;font-size:14px;font-weight:700;">Payment instructions</p>
                    <p style="margin:0;color:#4d5668;font-size:14px;line-height:1.5;white-space:pre-line;">{{ invoiceDisplay.snapshot.paymentInstructions }}</p>
                  </div>
                {% endif %}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
