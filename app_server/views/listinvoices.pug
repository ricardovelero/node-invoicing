extends layout

block content
  section.text-gray-600.body-font
    div(class="container mx-auto flex px-5 py-24 md:flex-row flex-col items-center")
      div(class="lg:flex-grow md:w-1/2 lg:pl-24 md:pl-16 flex flex-col items-center text-center")
        h1(class="title-font sm:text-4xl text-3xl mb-4 font-medium text-gray-900")= pageHeader.title
        p(class="hidden lg:inline-block")= pageHeader.strapline
        hr.my-5
        .flex.justify-center
          .grid-flow-col.gap-4.grid-rows-3
            .grid.grid-cols-3.gap-4
              each sampleInvoice in sampleInvoices
                a(href="/invoice/" class="")
                  div(class="block p-6 rounded-lg shadow-lg  max-w-sm transition ease-in-out delay-150 bg-white hover:-translate-y-0.5 hover:scale-110 hover:shadow-2xl duration-300")
                    h5.text-gray-900.text-xl.leading-tight.font-medium.mb-2 Vanessa Archila
                    p(class="text-gray-700.text-base.mb-4.space-y-0.5") Nº: #{sampleInvoice.invoice_number}, #{moment(sampleInvoice.invoice_date).format('LL')}
                    p(class="text-gray-700.text-base.mb-4.space-y-0.5") vencimiento: #{moment(sampleInvoice.due_date).format('LL')}
                    p(class="text-gray-700.text-base.mb-4.space-y-0.5") Total: €#{sampleInvoice.total}
                    p(class="text-gray-700.text-base.mb-4.space-y-0.5")
                                          