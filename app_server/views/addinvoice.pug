extends layout

block content
    section.text-gray-600.body-font
        div(class='max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8')
            div(class='max-w-3xl mx-auto')
                h1(class="title-font sm:text-4xl text-3xl mb-4 font-medium text-gray-900 text-center") Nueva Factura
                p.mt-1.text-sm.text-gray-500.text-center Completa toda la información para crear una nueva Factura.
                form.space-y-8.divide-y.divide-gray-200(method='POST')
                    .space-y-8.divide-y.divide-gray-200
                        .pt-8
                            .mt-6.grid.grid-cols-1.gap-y-6.gap-x-4(class='sm:grid-cols-6')
                                div(class='sm:col-span-3')
                                    label.block.text-sm.font-medium.text-gray-700(for='clientId')  Cliente 
                                    .mt-1
                                        select#country.shadow-sm.block.w-full.border-gray-300.rounded-md(name='clientId' autocomplete='client-name' class='focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm')
                                            each client in clients
                                              option(value=client.id)= client.name
                                div(class='sm:col-span-3')
                                  .mt-4(class='sm:mt-5 sm:ml-16')
                                    button.float-right.inline-flex.items-center.justify-center.rounded-md.border.border-transparent.bg-indigo-600.px-4.py-2.text-sm.font-medium.text-white.shadow-sm(type='button' class='hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto') Nuevo Cliente
                                div(class='sm:col-span-3')
                                    label.block.text-sm.font-medium.text-gray-700(for='invoice_date')  Fecha
                                    .mt-1
                                        input#last-name.shadow-sm.block.w-full.border-gray-300.rounded-md(type='date' name='invoice_date' autocomplete='invoice_date' class='focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm')
                                div(class='sm:col-span-3')
                                    label.block.text-sm.font-medium.text-gray-700(for='due-date')  Fecha Vencimiento 
                                    .mt-1
                                        input#email.shadow-sm.block.w-full.border-gray-300.rounded-md(name='due-date' type='date' autocomplete='due-date' class='focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm')
                                div(class='sm:col-span-3')
                                    .mt-1
                                        .flex.items-center
                                            input#recurrent.h-4.w-4.text-indigo-600.border-gray-300(name='is_recurrent' type='checkbox' class='focus:ring-indigo-500')
                                            label.ml-3.block.text-sm.font-medium.text-gray-700(for='is_recurrent') ¿Es Recurrente?
                        .pt-8
                          // This example requires Tailwind CSS v2.0+
                          div(class='sm:flex sm:items-center')
                            div(class='sm:flex-auto')
                              h1.text-xl.font-semibold.text-gray-900 Ítems
                              p.mt-2.text-sm.text-gray-700
                                | Puedes agregar un ítem pinchando en el botón sin perder los datos de la factura.
                            .mt-4(class='sm:mt-0 sm:ml-16 sm:flex-none')
                              button.inline-flex.items-center.justify-center.rounded-md.border.border-transparent.bg-indigo-600.px-4.py-2.text-sm.font-medium.text-white.shadow-sm(type='button' class='hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto') Nuevo ítem
                          .mt-8.flex.flex-col
                            .-my-2.-mx-4.overflow-x-auto(class='sm:-mx-6 lg:-mx-8')
                              .inline-block.min-w-full.py-2.align-middle(class='md:px-6 lg:px-8')
                                .overflow-hidden.shadow.ring-1.ring-black.ring-opacity-5(class='md:rounded-lg')
                                  table.min-w-full.divide-y.divide-gray-300
                                    thead.bg-gray-50
                                      tr
                                        th.px-3.text-left.text-sm.font-semibold.text-gray-900(scope='col')
                                          span.sr-only Eliminar
                                        th.px-3.text-left.text-sm.font-semibold.text-gray-900(scope='col' class='py-3.5 sm:pl-6') Ítem
                                        th.px-3.text-left.text-sm.font-semibold.text-gray-900(scope='col' class='py-3.5') Descripción
                                        th.px-3.text-left.text-sm.font-semibold.text-gray-900(scope='col' class='py-3.5') Costo 
                                        th.px-3.text-left.text-sm.font-semibold.text-gray-900(scope='col' class='py-3.5') Cantidad 
                                        th.px-3.text-left.text-sm.font-semibold.text-gray-900(scope='col' class='py-3.5') Precio 
                                    tbody.divide-y.divide-gray-200.bg-white
                                      tr
                                        td.whitespace-nowrap.pl-3.py-1.text-sm.text-gray-500
                                          a.text-indigo-600(href='#' class='hover:text-indigo-900')
                                            svg.h-6.w-6(xmlns='http://www.w3.org/2000/svg' fill='none' viewbox='0 0 24 24' stroke='currentColor' stroke-width='2')
                                              path(stroke-linecap='round' stroke-linejoin='round' d='M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z')
                                        td.whitespace-nowrap.pr-3.text-sm.font-medium.text-gray-900(class='sm:pl-6') Curso JS
                                        td.whitespace-nowrap.px-3.py-4.text-sm.text-gray-500 Curso completo de JavaScript
                                        td.whitespace-nowrap.px-3.py-4.text-sm.text-gray-500 $100
                                        td.whitespace-nowrap.px-3.py-4.text-sm.text-gray-500 2
                                        td.whitespace-nowrap.px-3.py-4.text-sm.text-gray-500 $200
                                      // More items...

                        .pt-8
                            div(class='sm:col-span-6')
                                label.block.text-sm.font-medium.text-gray-700(for='invoice_notes')  Notas 
                                    .mt-1
                                        textarea#about.shadow-sm.block.w-full.border.border-gray-300.rounded-md(name='invoice_notes' rows='3' class='focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm')
                                        p.mt-2.text-sm.text-gray-500 Condiciones de venta o alguna observación.
                    .pt-5
                        .flex.justify-end
                            a(href="/invoices" class="")
                                button.bg-white.py-2.px-4.border.border-gray-300.rounded-md.shadow-sm.text-sm.font-medium.text-gray-700(type='button' class='hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500') Cancelar 
                            a(href="/invoices/add" class="")
                                button.ml-3.inline-flex.justify-center.py-2.px-4.border.border-transparent.shadow-sm.text-sm.font-medium.rounded-md.text-white.bg-indigo-600(type='submit' class='hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500') Crear 
